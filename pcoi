                "new_str": "'use client';\n\nimport { useState } from 'react';\nimport { MobileLayout } from '../MobileLayout';\nimport { MobilePageWrapper } from '../MobilePageWrapper';\nimport { type MobileTab } from '../BottomNavigation';\n\nexport function MobilePlayerInterface() {\n  const [currentTab, setCurrentTab] = useState<MobileTab>('dashboard');\n\n  const getTabTitle = (tab: MobileTab): string => {\n    switch (tab) {\n      case 'dashboard': return 'Player Dashboard';\n      case 'team': return 'My Team';\n      case 'live': return 'Live Matches';\n      case 'media': return 'Venue Media';\n      case 'chat': return 'Venue Chat';\n      default: return 'Player';\n    }\n  };\n\n  const renderTabContent = () => {\n    switch (currentTab) {\n      case 'dashboard':\n        return (\n          <MobilePageWrapper>\n            <div className=\"space-y-4\">\n              <div className=\"bg-white rounded-lg p-4 shadow-sm\">\n                <h2 className=\"mobile-card-title mb-2\">My Team Status</h2>\n                <p className=\"mobile-body-text text-gray-600\">\n                  View your team information and status\n                </p>\n              </div>\n              <div className=\"bg-white rounded-lg p-4 shadow-sm\">\n                <h2 className=\"mobile-card-title mb-2\">Upcoming Matches</h2>\n                <p className=\"mobile-body-text text-gray-600\">\n                  Your next tournament matches\n                </p>\n              </div>\n            </div>\n          </MobilePageWrapper>\n        );\n      \n      case 'team':\n        return (\n          <MobilePageWrapper>\n            <div className=\"space-y-4\">\n              <div className=\"bg-white rounded-lg p-4 shadow-sm\">\n                <h2 className=\"mobile-card-title mb-2\">Team Details</h2>\n                <p className=\"mobile-body-text text-gray-600\">\n                  View your teammates and team information\n                </p>\n              </div>\n              <div className=\"bg-white rounded-lg p-4 shadow-sm\">\n                <h2 className=\"mobile-card-title mb-2\">My Verification</h2>\n                <p className=\"mobile-body-text text-gray-600\">\n                  Upload documents and check verification status\n                </p>\n              </div>\n            </div>\n          </MobilePageWrapper>\n        );\n      \n      case 'live':\n        return (\n          <MobilePageWrapper>\n            <div className=\"space-y-4\">\n              <div className=\"bg-white rounded-lg p-4 shadow-sm\">\n                <h2 className=\"mobile-card-title mb-2\">Tournament Bracket</h2>\n                <p className=\"mobile-body-text text-gray-600\">\n                  Follow the tournament progress\n                </p>\n              </div>\n            </div>\n          </MobilePageWrapper>\n        );\n      \n      case 'media':\n        return (\n          <MobilePageWrapper>\n            <div className=\"space-y-4\">\n              <div className=\"bg-white rounded-lg p-4 shadow-sm\">\n                <h2 className=\"mobile-card-title mb-2\">Venue Photos</h2>\n                <p className=\"mobile-body-text text-gray-600\">\n                  Browse photos and videos from your venue\n                </p>\n              </div>\n            </div>\n          </MobilePageWrapper>\n        );\n      \n      case 'chat':\n        return (\n          <MobilePageWrapper>\n            <div className=\"space-y-4\">\n              <div className=\"bg-white rounded-lg p-4 shadow-sm\">\n                <h2 className=\"mobile-card-title mb-2\">Team Chat</h2>\n                <p className=\"mobile-body-text text-gray-600\">\n                  Connect with other teams at your venue\n                </p>\n              </div>\n            </div>\n          </MobilePageWrapper>\n        );\n      \n      default:\n        return null;\n    }\n  };\n\n  return (\n    <MobileLayout\n      currentTab={currentTab}\n      onTabChange={setCurrentTab}\n      title={getTabTitle(currentTab)}\n      role=\"player\"\n      notificationCount={2}\n    >\n      {renderTabContent()}\n    </MobileLayout>\n  );\n}",
                "command": "create"
              }
            }
          ]
        }
