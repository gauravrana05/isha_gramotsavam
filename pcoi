g p-4 shadow-sm\">\n                <h2 className=\"mobile-card-title mb-2\">Team Roster</h2>\n                <p className=\"mobile-body-text text-gray-600\">\n                  Manage your team players\n                </p>\n              </div>\n            </div>\n          </MobilePageWrapper>\n        );\n      \n      case 'live':\n        return (\n          <MobilePageWrapper>\n            <div className=\"space-y-4\">\n              <div className=\"bg-white rounded-lg p-4 shadow-sm\">\n                <h2 className=\"mobile-card-title mb-2\">Live Matches</h2>\n                <p className=\"mobile-body-text text-gray-600\">\n                  Tournament matches and brackets\n                </p>\n              </div>\n            </div>\n          </MobilePageWrapper>\n        );\n      \n      case 'media':\n        return (\n          <MobilePageWrapper>\n            <div className=\"space-y-4\">\n              <div className=\"bg-white rounded-lg p-4 shadow-sm\">\n                <h2 className=\"mobile-card-title mb-2\">Venue Media</h2>\n                <p className=\"mobile-body-text text-gray-600\">\n                  Photos and videos from your venue\n                </p>\n              </div>\n            </div>\n          </MobilePageWrapper>\n        );\n      \n      case 'chat':\n        return (\n          <MobilePageWrapper>\n            <div className=\"space-y-4\">\n              <div className=\"bg-white rounded-lg p-4 shadow-sm\">\n                <h2 className=\"mobile-card-title mb-2\">Venue Chat</h2>\n                <p className=\"mobile-body-text text-gray-600\">\n                  Chat with other teams at your venue\n                </p>\n              </div>\n            </div>\n          </MobilePageWrapper>\n        );\n      \n      default:\n        return null;\n    }\n  };\n\n  return (\n    <MobileLayout\n      currentTab={currentTab}\n      onTabChange={setCurrentTab}\n      title={getTabTitle(currentTab)}\n      role=\"cap