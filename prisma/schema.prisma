generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

model AuditLog {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String?   @map("user_id") @db.Uuid
  action      String    @db.VarChar(100)
  entityType  String    @map("entity_type") @db.VarChar(50)
  entityId    String    @map("entity_id") @db.Uuid
  changes     Json      @default("{}")
  metadata    Json      @default("{}")
  comments    String?
  ipAddress   String?   @map("ip_address") @db.Inet
  userAgent   String?   @map("user_agent")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)

  // Relations
  user User? @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

model ClusterDivisionMapping {
  id                     String @id @default(uuid()) @db.Uuid
  eventId                String @map("event_id") @db.Uuid
  state                  String @db.VarChar(100)
  clusterVenueMappingId  String @map("cluster_venue_mapping_id") @db.Uuid
  divisionVenueMappingId String @map("division_venue_mapping_id") @db.Uuid
  autoAssigned           Boolean @default(false) @map("auto_assigned")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  // Relations
  clusterVenueMapping  VenueLevelMapping @relation("ClusterToDivision", fields: [clusterVenueMappingId], references: [id], onDelete: Cascade)
  divisionVenueMapping VenueLevelMapping @relation("DivisionToCluster", fields: [divisionVenueMappingId], references: [id], onDelete: Cascade)
  event                Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  // Constraints
  @@unique([eventId, clusterVenueMappingId])
  @@index([eventId, clusterVenueMappingId, divisionVenueMappingId])

  @@map("cluster_division_mappings")
}

model Event {
  id                  String @id @default(uuid()) @db.Uuid
  name                String @db.VarChar(200)
  description         String?
  registrationStartDate DateTime @map("registration_start_date") @db.Date
  registrationEndDate DateTime @map("registration_end_date") @db.Date
  startDate           DateTime @map("start_date") @db.Date
  endDate             DateTime @map("end_date") @db.Date
  status              EventStatus @default(draft)

  createdBy String @map("created_by") @db.Uuid
  createdAt DateTime @map("created_at") @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @map("updated_at") @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  // Relations
  clusterDivisionMappings ClusterDivisionMapping[]
  createdByUser         User @relation("EventsCreated", fields: [createdBy], references: [id])
  fixtures              Fixture[]
  matches               Match[]
  locationClusterMappings LocationClusterMapping[]
  posts                 Post[]
  teamVenueAssignments  TeamVenueAssignment[]
  teams                 Team[]
  userRoles             UserRoleAssignment[]
  venueLevelMappings VenueLevelMapping[]
  volunteerAssignments  VolunteerAssignment[]

  @@map("events")
}

model FixtureResult {
  id                String @id @default(uuid()) @db.Uuid
  fixtureId         String @map("fixture_id") @db.Uuid
  teamId            String @map("team_id") @db.Uuid
  finalPosition     Int
  qualifiesForNext  Boolean @default(false) @map("qualifies_for_next")
  recordedBy        String? @map("recorded_by") @db.Uuid
  recordedAt        DateTime? @map("recorded_at") @db.Timestamptz(6)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz(6)

  fixture Fixture @relation(fields: [fixtureId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [recordedBy], references: [id])
  team    Team    @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([fixtureId, finalPosition], map: "fixture_results_fixture_id_position_key")
  @@unique([fixtureId, teamId])
  @@index([fixtureId])
  @@index([teamId])
  @@map("fixture_results")
}

model FixtureTeam {
  fixtureId        String @map("fixture_id") @db.Uuid
  teamId           String @map("team_id") @db.Uuid

  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz(6)

  checkedIn        Boolean @default(false) @map("checked_in")
  checkedInAt      DateTime? @map("checked_in_at") @db.Timestamptz(6)
  checkedInBy      String? @map("checked_in_by") @db.Uuid

  finalPosition    Int? @map("final_position")
  qualifiesForNext Boolean @default(false) @map("qualifies_for_next")
  tournamentPoints Int? @map("tournament_points")

  resultRecordedAt DateTime? @map("result_recorded_at") @db.Timestamptz(6)
  resultRecordedBy String? @map("result_recorded_by") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  // Relations
  fixture Fixture @relation(fields: [fixtureId], references: [id], onDelete: Cascade)
  team    Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  checkedInUser User? @relation("FixtureTeamsCheckedIn", fields: [checkedInBy], references: [id])
  resultRecordedByUser User? @relation("FixtureTeamsResultRecorded", fields: [resultRecordedBy], references: [id])

  @@id([fixtureId, teamId])
  @@unique([fixtureId, finalPosition], map: "fixture_teams_fixture_id_final_position_key")
  @@index([fixtureId])
  @@index([teamId])
  @@map("fixture_teams")
}

model Fixture {
  id                     String @id @default(uuid()) @db.Uuid
  name                   String @db.VarChar(200)
  eventId                String? @db.Uuid @map("event_id")
  sportId                String @db.Uuid @map("sport_id")
  venueLevelMappingId String @db.Uuid @map("venue_level_mapping_id")
  genderCategory         GenderCategory @map("gender_category")
  level                  TournamentLevel
  status                 FixtureStatus @default(draft)
  championTeamId         String? @db.Uuid @map("champion_team_id")
  championTeamName       String? @db.VarChar(200) @map("champion_team_name")
  completedAt            DateTime? @db.Timestamptz(6) @map("completed_at")
  createdAt              DateTime @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt              DateTime @updatedAt @db.Timestamptz(6) @map("updated_at")
  deletedAt              DateTime? @db.Timestamptz(6) @map("deleted_at")

  fixtureResults         FixtureResult[]
  fixtureTeams           FixtureTeam[]

  event                Event? @relation(fields: [eventId], references: [id])
  sport                Sport @relation(fields: [sportId], references: [id])
  venueLevelMapping VenueLevelMapping @relation(fields: [venueLevelMappingId], references: [id])
  matches              Match[]

  @@index([eventId, sportId, venueLevelMappingId, genderCategory, level])
  @@map("fixtures")
}

model Match {
  id                     String @id @default(uuid()) @db.Uuid
  fixtureId              String @db.Uuid @map("fixture_id")
  eventId                String? @db.Uuid @map("event_id")
  sportId                String @db.Uuid @map("sport_id")
  venueLevelMappingId String @db.Uuid @map("venue_level_mapping_id")
  genderCategory         GenderCategory @map("gender_category")
  roundName              String @db.VarChar(100) @map("round_name")
  matchNumber            Int @map("match_number")
  team1Id                String? @db.Uuid @map("team1_id")
  team2Id                String? @db.Uuid @map("team2_id")
  dependsOnMatch1Id      String? @db.Uuid @map("depends_on_match1_id")
  dependsOnMatch2Id      String? @db.Uuid @map("depends_on_match2_id")
  nextMatchId            String? @db.Uuid @map("next_match_id")
  nextSlot               String? @db.VarChar(10) @map("next_slot")
  winnerId               String? @db.Uuid @map("winner_id")
  winnerName             String? @db.VarChar(200) @map("winner_name")
  team1Score             Int? @map("team1_score")
  team2Score             Int? @map("team2_score")
  scoreDetails           String? @map("score_details")
  resultEnteredBy        String? @db.Uuid @map("result_entered_by")
  resultEnteredAt        DateTime? @db.Timestamptz(6) @map("result_entered_at")
  scheduledTime          DateTime? @db.Timestamptz(6) @map("scheduled_time")
  actualStartTime        DateTime? @db.Timestamptz(6) @map("actual_start_time")
  status                 MatchStatus @default(scheduled)
  createdAt              DateTime @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt              DateTime @updatedAt @db.Timestamptz(6) @map("updated_at")
  deletedAt              DateTime? @db.Timestamptz(6) @map("deleted_at")

  dependsOnMatch1      Match? @relation("DependsOnMatch1", fields: [dependsOnMatch1Id], references: [id])
  otherDependsOnMatch1 Match[] @relation("DependsOnMatch1")
  dependsOnMatch2      Match? @relation("DependsOnMatch2", fields: [dependsOnMatch2Id], references: [id])
  otherDependsOnMatch2 Match[] @relation("DependsOnMatch2")
  nextMatch            Match? @relation("NextMatch", fields: [nextMatchId], references: [id])
  otherNextMatches     Match[] @relation("NextMatch")

  event                Event? @relation(fields: [eventId], references: [id])
  fixture              Fixture @relation(fields: [fixtureId], references: [id], onDelete: Cascade)
  sport                Sport @relation(fields: [sportId], references: [id])
  venueLevelMapping VenueLevelMapping @relation(fields: [venueLevelMappingId], references: [id])
  team1                Team? @relation("MatchTeam1", fields: [team1Id], references: [id])
  team2                Team? @relation("MatchTeam2", fields: [team2Id], references: [id])
  winner               Team? @relation("MatchWinner", fields: [winnerId], references: [id])
  resultEnteredByUser  User? @relation(fields: [resultEnteredBy], references: [id])

  @@unique([fixtureId, matchNumber])
  @@map("matches")

  // Indexes
  @@index([fixtureId])
  @@index([eventId])
  @@index([sportId])
  @@index([venueLevelMappingId])
  @@index([team1Id])
  @@index([team2Id])
  @@index([winnerId])
}

model Media {
  id           String @id @default(uuid()) @db.Uuid
  fileName     String @db.VarChar(255) @map("file_name")
  filePath     String @db.VarChar(500) @map("file_path")
  fileType     String @db.VarChar(50) @map("file_type")
  fileSize     BigInt?
  entityType   MediaEntity @map("entity_type")
  entityId     String @db.Uuid @map("entity_id")
  uploadedBy   String? @db.Uuid @map("uploaded_by")
  status       MediaStatus @default(approved)
  createdAt    DateTime @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt    DateTime @updatedAt @db.Timestamptz(6) @map("updated_at")
  deletedAt    DateTime? @db.Timestamptz(6) @map("deleted_at")

  postId      String? @map("post_id") @db.Uuid
  caption     String? @db.VarChar(500)
  orderInPost Int? @map("order_in_post")
  post        Post? @relation(fields: [postId], references: [id])

  // Relations
  uploadedByUser User? @relation(fields: [uploadedBy], references: [id])

  // Indexes
  @@index([entityId])
  @@index([uploadedBy])
  @@map("media")
}

model Notification {
  id                  String @id @default(uuid()) @db.Uuid
  userId              String @db.Uuid @map("user_id")
  title               String @db.VarChar(200)
  message             String
  type                NotificationType
  read                Boolean @default(false)
  readAt              DateTime? @db.Timestamptz(6) @map("read_at")
  relatedEntityType   String? @db.VarChar(50) @map("related_entity_type")
  relatedEntityId     String? @db.Uuid @map("related_entity_id")
  actionUrl           String? @db.VarChar(500) @map("action_url")
  
  // Enhanced notification fields
  createdBy           String? @db.Uuid @map("created_by")
  templateId          String? @db.Uuid @map("template_id")
  broadcastId         String? @db.Uuid @map("broadcast_id")
  scheduledFor        DateTime? @db.Timestamptz(6) @map("scheduled_for")
  deliveryStatus      NotificationDeliveryStatus @default(pending) @map("delivery_status")
  deliveredAt         DateTime? @db.Timestamptz(6) @map("delivered_at")
  pushSent            Boolean @default(false) @map("push_sent")
  pushSentAt          DateTime? @db.Timestamptz(6) @map("push_sent_at")
  
  createdAt           DateTime @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt           DateTime @updatedAt @db.Timestamptz(6) @map("updated_at")
  deletedAt           DateTime? @db.Timestamptz(6) @map("deleted_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdByUser User? @relation("NotificationsCreated", fields: [createdBy], references: [id])
  template NotificationTemplate? @relation(fields: [templateId], references: [id])
  broadcast NotificationBroadcast? @relation(fields: [broadcastId], references: [id])

  // Indexes
  @@index([userId])
  @@index([createdBy])
  @@index([relatedEntityId])
  @@index([broadcastId])
  @@index([deliveryStatus])
  @@index([scheduledFor])
  @@map("notifications")
}

model NotificationTemplate {
  id          String @id @default(uuid()) @db.Uuid
  name        String @db.VarChar(100)
  title       String @db.VarChar(200)
  message     String
  type        NotificationType
  category    NotificationCategory @default(general)
  isActive    Boolean @default(true) @map("is_active")
  variables   Json @default("{}")
  createdBy   String @db.Uuid @map("created_by")
  createdAt   DateTime @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt   DateTime @updatedAt @db.Timestamptz(6) @map("updated_at")
  deletedAt   DateTime? @db.Timestamptz(6) @map("deleted_at")

  // Relations
  createdByUser User @relation("NotificationTemplatesCreated", fields: [createdBy], references: [id])
  notifications Notification[]

  @@index([category])
  @@index([isActive])
  @@map("notification_templates")
}

model NotificationBroadcast {
  id                String @id @default(uuid()) @db.Uuid
  title             String @db.VarChar(200)
  message           String
  type              NotificationType
  targetRoles       Json @default("[]")
  targetVenueIds    Json @default("[]")
  scheduledFor      DateTime? @db.Timestamptz(6) @map("scheduled_for")
  status            NotificationBroadcastStatus @default(draft)
  totalRecipients   Int @default(0) @map("total_recipients")
  deliveredCount    Int @default(0) @map("delivered_count")
  readCount         Int @default(0) @map("read_count")
  createdBy         String @db.Uuid @map("created_by")
  createdAt         DateTime @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt         DateTime @updatedAt @db.Timestamptz(6) @map("updated_at")
  sentAt            DateTime? @db.Timestamptz(6) @map("sent_at")
  deletedAt         DateTime? @db.Timestamptz(6) @map("deleted_at")

  // Relations
  createdByUser User @relation("NotificationBroadcastsCreated", fields: [createdBy], references: [id])
  notifications Notification[]

  @@index([status])
  @@index([createdBy])
  @@index([scheduledFor])
  @@map("notification_broadcasts")
}

model NotificationSettings {
  id                    String @id @default(uuid()) @db.Uuid
  userId                String @unique @db.Uuid @map("user_id")
  pushEnabled           Boolean @default(true) @map("push_enabled")
  emailEnabled          Boolean @default(true) @map("email_enabled")
  matchUpdates          Boolean @default(true) @map("match_updates")
  teamUpdates           Boolean @default(true) @map("team_updates")
  verificationUpdates   Boolean @default(true) @map("verification_updates")
  systemAnnouncements   Boolean @default(true) @map("system_announcements")
  pushSubscription      Json? @map("push_subscription")
  createdAt             DateTime @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt             DateTime @updatedAt @db.Timestamptz(6) @map("updated_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_settings")
}

model SportGenderCategory {
  sportId      String @db.Uuid @map("sport_id")
  genderCategory GenderCategory @map("gender_category")

  // Relations
  sport        Sport @relation(fields: [sportId], references: [id], onDelete: Cascade)

  // Composite primary key
  @@id([sportId, genderCategory])
  @@map("sport_gender_categories")
}

model Sport {
  id                  String @id @default(uuid()) @db.Uuid
  name                String @db.VarChar(100)
  description         String?
  mainPlayersCount    Int @map("main_players_count")
  maxSubstitutes      Int @map("max_substitutes")
  isActive            Boolean @default(true) @map("is_active")
  createdAt           DateTime @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt           DateTime @updatedAt @db.Timestamptz(6) @map("updated_at")
  deletedAt           DateTime? @db.Timestamptz(6) @map("deleted_at")

  // Relations
  fixtures            Fixture[]
  matches             Match[]
  sportGenderCategories SportGenderCategory[]
  teams               Team[]

  @@map("sports")
}

model SystemConfig {
  id          String @id @default(uuid()) @db.Uuid
  key         String @unique @db.VarChar(100)
  value       String
  description String?
  updatedBy   String? @db.Uuid @map("updated_by")
  createdAt   DateTime @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt   DateTime @updatedAt @db.Timestamptz(6) @map("updated_at")
  deletedAt   DateTime? @db.Timestamptz(6) @map("deleted_at")

  // Relations
  updatedByUser User? @relation(fields: [updatedBy], references: [id])

  @@map("system_config")
}

enum LocationType {
  district
  taluk
}

model LocationClusterMapping {
  id                    String @id @default(uuid()) @db.Uuid
  eventId               String @db.Uuid @map("event_id")
  locationType          LocationType @map("location_type")
  locationName          String @db.VarChar(100) @map("location_name")
  state                 String @db.VarChar(100)
  district              String? @db.VarChar(100) // null for district mappings, populated for taluk mappings
  clusterVenueMappingId String @db.Uuid @map("cluster_venue_mapping_id")
  createdAt             DateTime @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt             DateTime @updatedAt @db.Timestamptz(6) @map("updated_at")
  deletedAt             DateTime? @db.Timestamptz(6) @map("deleted_at")

  // Relations
  venueLevelMapping VenueLevelMapping @relation(fields: [clusterVenueMappingId], references: [id], onDelete: Cascade)
  event                Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, locationType, locationName, state, district])
  @@index([eventId])
  @@index([clusterVenueMappingId])
  @@index([locationType])
  @@map("location_cluster_mappings")
}

model TeamPhoto {
  teamId       String @id @map("team_id") @db.Uuid
  photoPath    String @db.VarChar(500) @map("photo_path")
  uploadedBy   String? @db.Uuid @map("uploaded_by")
  uploadedAt   DateTime @default(now()) @db.Timestamptz(6) @map("uploaded_at")
  createdAt    DateTime @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt    DateTime @updatedAt @db.Timestamptz(6) @map("updated_at")
  deletedAt    DateTime? @db.Timestamptz(6) @map("deleted_at")

  // Relations
  team         Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  uploadedByUser User? @relation(fields: [uploadedBy], references: [id])

  @@map("team_photos")
  @@index([teamId])
  @@index([uploadedBy])
}

model TeamPlayer {
  id                 String @id @default(uuid()) @db.Uuid
  teamId             String @db.Uuid @map("team_id")
  userId             String @db.Uuid @map("user_id")
  position           PlayerPosition
  verificationStatus VerificationStatus @default(pending) @map("verification_status")
  firstName          String @db.VarChar(100) @map("first_name")
  lastName           String @db.VarChar(100) @map("last_name")
  phone              String @db.VarChar(20)
  whatsappNumber     String? @db.VarChar(20) @map("whatsapp_number")
  dateOfBirth        DateTime @db.Date @map("date_of_birth")
  age                Int
  gender             Gender
  panchayat          String @db.VarChar(100)
  taluk              String @db.VarChar(100)
  district           String @db.VarChar(100)
  state              String @db.VarChar(100)
  pincode            String @db.VarChar(10)
  addedAt            DateTime @default(now()) @map("added_at") @db.Timestamptz(6)
  addedBy            String @db.VarChar(50) @map("added_by")
  createdAt          DateTime @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt          DateTime @updatedAt @db.Timestamptz(6) @map("updated_at")
  deletedAt          DateTime? @db.Timestamptz(6) @map("deleted_at")

  // Relations
  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([teamId])
  @@index([userId])
  @@map("team_players")
}

model TeamVenueAssignment {
  id                      String @id @default(uuid()) @db.Uuid
  teamId                  String @db.Uuid @map("team_id")
  eventId                 String @db.Uuid @map("event_id")
  level                   TournamentLevel @default(cluster)
  clusterVenueMappingId   String @db.Uuid @map("cluster_venue_mapping_id")
  divisionVenueMappingId  String? @db.Uuid @map("division_venue_mapping_id")
  finalVenueMappingId     String? @db.Uuid @map("final_venue_mapping_id")
  clusterQualified        Boolean @default(false) @map("cluster_qualified")
  divisionQualified       Boolean @default(false) @map("division_qualified")
  finalQualified          Boolean @default(false) @map("final_qualified")
  assignmentMethod        AssignmentMethod @default(auto_assigned) @map("assignment_method")
  assignedBy              String @db.Uuid @map("assigned_by")
  assignedAt              DateTime @default(now()) @map("assigned_at") @db.Timestamptz(6)
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt               DateTime? @db.Timestamptz(6) @map("deleted_at")

  // Relations
  assignedByUser          User @relation(fields: [assignedBy], references: [id])
  clusterVenueMapping     VenueLevelMapping @relation("TeamVenueAssignmentClusterVenue", fields: [clusterVenueMappingId], references: [id])
  divisionVenueMapping    VenueLevelMapping? @relation("TeamVenueAssignmentDivisionVenue", fields: [divisionVenueMappingId], references: [id])
  finalVenueMapping       VenueLevelMapping? @relation("TeamVenueAssignmentFinalVenue", fields: [finalVenueMappingId], references: [id])
  event                   Event @relation(fields: [eventId], references: [id])
  team                    Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, eventId])
  @@index([teamId])
  @@index([eventId])
  @@map("team_venue_assignments")
}

model Team {
  id                           String @id @default(uuid()) @db.Uuid
  name                         String @db.VarChar(200)
  description                  String?
  eventId                      String? @db.Uuid @map("event_id")
  sportId                      String @db.Uuid @map("sport_id")
  captainId                    String @db.Uuid @map("captain_id")
  captainName                  String @db.VarChar(200) @map("captain_name")
  genderCategory               GenderCategory @map("gender_category")
  status                       TeamStatus @default(draft)
  panchayat                    String @db.VarChar(100)
  taluk                        String @db.VarChar(100)
  district                     String @db.VarChar(100)
  state                        String @db.VarChar(100)
  pincode                      String? @db.VarChar(10)
  currentPlayers               Int @default(0) @map("current_players")
  currentSubstitutes           Int @default(0) @map("current_substitutes")
  tournamentNumber             Int? @map("tournament_number")
  tournamentNumberAssignedAt   DateTime? @db.Timestamptz(6) @map("tournament_number_assigned_at")
