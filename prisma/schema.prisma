  verifiedBy                   String? @db.Uuid @map("verified_by")
  verifiedAt                   DateTime? @db.Timestamptz(6) @map("verified_at")
  createdAt                    DateTime @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt                    DateTime @updatedAt @db.Timestamptz(6) @map("updated_at")
  deletedAt                    DateTime? @db.Timestamptz(6) @map("deleted_at")

  // Relations
  fixtureResults               FixtureResult[]
  fixtureTeams                 FixtureTeam[]
  matchesAsTeam1               Match[] @relation("MatchTeam1")
  matchesAsTeam2               Match[] @relation("MatchTeam2")
  matchesAsWinner              Match[] @relation("MatchWinner")
  teamPhoto                    TeamPhoto?
  teamPlayers                  TeamPlayer[]
  teamVenueAssignments         TeamVenueAssignment[]
  captainUser                  User @relation("TeamsAsCaptain", fields: [captainId], references: [id])
  verifiedByUser               User? @relation("TeamsVerifiedBy", fields: [verifiedBy], references: [id])
  event                        Event? @relation(fields: [eventId], references: [id])
  sport                        Sport @relation(fields: [sportId], references: [id])
  venueLevelMapping         VenueLevelMapping? @relation(fields: [tournamentNumberVenueMappingId], references: [id])

  @@index([eventId])
  @@index([sportId])
  @@index([captainId])
  @@index([verifiedBy])
  @@map("teams")
}

