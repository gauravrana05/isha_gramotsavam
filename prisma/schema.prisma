model VenueLevelMapping {
  id          String @id @default(uuid()) @db.Uuid
  eventId     String @map("event_id") @db.Uuid
  venueId     String @map("venue_id") @db.Uuid
  level       TournamentLevel
  maxTeams    Int? @map("max_teams") @default(100)
  isActive    Boolean @map("is_active") @default(true)

  createdAt DateTime @map("created_at") @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @map("updated_at") @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  // Relations
  clusterDivisionMappingsByCluster ClusterDivisionMapping[] @relation("ClusterToDivision")
  clusterDivisionMappingsByDivision ClusterDivisionMapping[] @relation("DivisionToCluster")

  fixtures Fixture[]
  matches  Match[]
  locationClusterMappings LocationClusterMapping[]

  teamVenueAssignmentsByCluster TeamVenueAssignment[] @relation("TeamVenueAssignmentClusterVenue")
  teamVenueAssignmentsByDivision TeamVenueAssignment[] @relation("TeamVenueAssignmentDivisionVenue")
  teamVenueAssignmentsByFinal TeamVenueAssignment[] @relation("TeamVenueAssignmentFinalVenue")

  teams                Team[]
  event                Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  venue                Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)
  volunteerAssignments VolunteerAssignment[]

  @@map("venue_level_mappings")
  @@unique([eventId, venueId, level], map: "venue_level_mappings_unique")
  @@index([eventId], map: "idx_venue_level_mappings_event_id")
  @@index([venueId], map: "idx_venue_level_mappings_venue_id")
  @@index([level], map: "idx_venue_level_mappings_level")
}

model Venue {
  id            String @id @default(uuid()) @db.Uuid
  name          String @db.VarChar(200)
  address       String? @db.VarChar(500)
  panchayat     String? @db.VarChar(100)
  taluk         String? @db.VarChar(100)
  district      String @db.VarChar(100)
  state         String @db.VarChar(100)
  pincode       String? @db.VarChar(10)
  isActive      Boolean @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  // Relations
  venueLevelMappings VenueLevelMapping[]

  @@map("venues")

  @@index([district, state], map: "idx_venue_location")
  @@index([pincode], map: "idx_venue_pincode")
  @@index([isActive], map: "idx_venue_is_active")
  @@index([name], map: "idx_venue_name")
}

model VolunteerAssignment {
  id                     String @id @default(uuid()) @db.Uuid

  eventId                String @map("event_id") @db.Uuid
  volunteerId            String @map("volunteer_id") @db.Uuid
  venueLevelMappingId    String @map("venue_level_mapping_id") @db.Uuid

  volunteerType          VolunteerType @map("volunteer_type")
  contactPhone           String? @map("contact_phone") @db.VarChar(20)
  status                 AssignmentStatus @default(assigned)

  assignedBy             String @map("assigned_by") @db.Uuid
  assignedAt             DateTime @map("assigned_at") @default(now()) @db.Timestamptz(6)

  createdAt DateTime @map("created_at") @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @map("updated_at") @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  // Relations
  assignedByUser       User @relation("VolunteerAssignmentsAssignedBy", fields: [assignedBy], references: [id])
  volunteerUser        User @relation("VolunteerAssignmentsAsVolunteer", fields: [volunteerId], references: [id], onDelete: Cascade)
  event                Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  venueLevelMapping    VenueLevelMapping @relation(fields: [venueLevelMappingId], references: [id], onDelete: Cascade)

  // Composite uniqueness
  @@unique([eventId, volunteerId, venueLevelMappingId], map: "volunteer_assignments_unique")

  // Useful indexes
  @@index([eventId], map: "idx_volunteer_assignments_event_id")
  @@index([volunteerId], map: "idx_volunteer_assignments_volunteer_id")
  @@index([venueLevelMappingId], map: "idx_volunteer_assignments_venue_level_mapping_id")
  @@index([assignedBy], map: "idx_volunteer_assignments_assigned_by")
  @@index([status], map: "idx_volunteer_assignments_status")
  @@index([deletedAt], map: "idx_volunteer_assignments_deleted_at")

  @@map("volunteer_assignments")
}

model UserRoleAssignment {
  id         String @id @default(uuid()) @db.Uuid
  userId     String @map("user_id") @db.Uuid
  eventId    String? @map("event_id") @db.Uuid
  role       UserRole
  assignedAt DateTime @map("assigned_at") @default(now()) @db.Timestamptz(6)
  assignedBy String? @map("assigned_by") @db.Uuid
  createdAt  DateTime @map("created_at") @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime @map("updated_at") @updatedAt @db.Timestamptz(6)
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz(6)

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  event Event? @relation(fields: [eventId], references: [id], onDelete: Cascade)
  assignedByUser User? @relation("UserRoleAssignments_AssignedBy", fields: [assignedBy], references: [id])

  @@unique([userId, eventId, role], map: "user_roles_unique")
  @@map("user_roles")
}

