import { apiClient } from '@/utils/api-client';
import { mockApiCall, mockApiError } from '../utils/test-helpers';

// Mock the API client
jest.mock('@/utils/api-client');
const mockedApiClient = apiClient as jest.Mocked<typeof apiClient>;

describe('{{ApiName}} API', () => {
  beforeEach(() => {
    jest.clearAllMocks();
  });

  describe('GET /{{endpoint}}', () => {
    it('fetches data successfully', async () => {
      const mockData = { id: 1, name: 'Test' };
      mockedApiClient.get.mockResolvedValue(mockData);

      const result = await apiClient.get('/{{endpoint}}');

      expect(mockedApiClient.get).toHaveBeenCalledWith('/{{endpoint}}');
      expect(result).toEqual(mockData);
    });

    it('handles API errors', async () => {
      const errorMessage = 'Network error';
      mockedApiClient.get.mockRejectedValue(new Error(errorMessage));

      await expect(apiClient.get('/{{endpoint}}')).rejects.toThrow(errorMessage);
    });
  });

  describe('POST /{{endpoint}}', () => {
    it('creates resource successfully', async () => {
      const newData = { name: 'New Item' };
      const createdData = { id: 1, ...newData };
      mockedApiClient.post.mockResolvedValue(createdData);

      const result = await apiClient.post('/{{endpoint}}', newData);

      expect(mockedApiClient.post).toHaveBeenCalledWith('/{{endpoint}}', newData);
      expect(result).toEqual(createdData);
    });

    it('handles validation errors', async () => {
      const invalidData = { name: '' };
      const validationError = {
        code: 'BAD_REQUEST',
        message: 'Validation failed',
        errors: [{ field: 'name', message: 'Name is required' }],
      };
      
      mockedApiClient.post.mockRejectedValue(validationError);

      await expect(apiClient.post('/{{endpoint}}', invalidData)).rejects.toEqual(validationError);
    });
  });

  describe('PUT /{{endpoint}}/:id', () => {
    it('updates resource successfully', async () => {
      const id = '1';
      const updateData = { name: 'Updated Item' };
      const updatedData = { id, ...updateData };
      mockedApiClient.put.mockResolvedValue(updatedData);

      const result = await apiClient.put(`/{{endpoint}}/${id}`, updateData);

      expect(mockedApiClient.put).toHaveBeenCalledWith(`/{{endpoint}}/${id}`, updateData);
      expect(result).toEqual(updatedData);
    });

    it('handles not found errors', async () => {
      const id = 'nonexistent';
      const updateData = { name: 'Updated Item' };
      const notFoundError = {
        code: 'NOT_FOUND',
        message: 'Resource not found',
      };
      
      mockedApiClient.put.mockRejectedValue(notFoundError);

      await expect(apiClient.put(`/{{endpoint}}/${id}`, updateData)).rejects.toEqual(notFoundError);
    });
  });

  describe('DELETE /{{endpoint}}/:id', () => {
    it('deletes resource successfully', async () => {
      const id = '1';
      mockedApiClient.delete.mockResolvedValue({ success: true });

      const result = await apiClient.delete(`/{{endpoint}}/${id}`);

      expect(mockedApiClient.delete).toHaveBeenCalledWith(`/{{endpoint}}/${id}`);
      expect(result).toEqual({ success: true });
    });

    it('handles authorization errors', async () => {
      const id = '1';
      const authError = {
        code: 'FORBIDDEN',
        message: 'Insufficient permissions',
      };
      
      mockedApiClient.delete.mockRejectedValue(authError);

      await expect(apiClient.delete(`/{{endpoint}}/${id}`)).rejects.toEqual(authError);
    });
  });
});
