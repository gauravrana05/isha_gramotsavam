import { z } from 'zod';
import { router, protectedProcedure } from '../trpc';
import { createCRUDRouter } from './crud-base';

// Define your schemas
const create{{ModelName}}Schema = z.object({
  name: z.string().min(1),
  description: z.string().optional(),
  // Add more fields as needed
});

const update{{ModelName}}Schema = create{{ModelName}}Schema.partial();

// Create CRUD router
export const {{modelName}}Router = createCRUDRouter(
  '{{modelName}}',
  create{{ModelName}}Schema,
  update{{ModelName}}Schema
);

// Add custom endpoints if needed
export const extended{{ModelName}}Router = router({
  ...{{modelName}}Router,
  
  // Custom endpoint example
  getPublic: protectedProcedure
    .query(async ({ ctx }) => {
      return ctx.prisma.{{modelName}}.findMany({
        where: { isPublic: true },
        select: {
          id: true,
          name: true,
          description: true,
        }
      });
    }),
});
