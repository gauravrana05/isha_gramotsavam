{
  "functions": {
    "source": "src/lib/firebase/functions",
    "runtime": "nodejs20",
    "region": "us-central1"
  },
  "firestore": {
    "rules": "src/lib/firebase/firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "src/lib/firebase/storage.rules"
  },
  "hosting": {
    "public": "out",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}