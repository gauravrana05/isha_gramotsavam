                "file_text": "import Redis from 'ioredis';\nimport { ProjectContext } from './project-context.js';\n\nexport class AgentContext {\n  constructor(agentName, projectId) {\n    this.agentName = agentName;\n    this.projectId = projectId;\n    this.redis = new Redis(process.env.REDIS_URL || 'redis://localhost:6379');\n    this.projectContext = new ProjectContext(projectId);\n  }\n\n  // Agent-specific memory\n  async setMemory(key, value) {\n    await this.redis.hset(`agent:${this.agentName}:${this.projectId}`, key, JSON.stringify({\n      value,\n      timestamp: new Date().toISOString()\n    }));\n  }\n\n  async getMemory(key) {\n    const data = await this.redis.hget(`agent:${this.agentName}:${this.projectId}`, key);\n    return data ? JSON.parse(data).value : null;\n  }\n\n  async getAllMemory() {\n    const data = await this.redis.hgetall(`agent:${this.agentName}:${this.projectId}`);\n    const memory = {};\n    for (const [key, value] of Object.entries(data)) {\n      memory[key] = JSON.parse(value).value;\n    }\n    return memory;\n  }\n\n  // Conversation history\n  async addConversation(task, requirements, result) {\n    const conversations = await this.getMemory('conversations') || [];\n    conversations.push({\n      id: `conv_${Date.now()}`,\n      timestamp: new Date().toISOString(),\n      task,\n      requirements,\n      result: {\n        filesGenerated: result.files?.length || 0,\n        success: result.success !== false\n      }\n    });\n    \n    // Keep only last 50 conversations\n    if (conversations.length > 50) {\n      conversations.splice(0, conversations.length - 50);\n    }\n    \n    await this.setMemory('conversations', conversations);\n  }\n\n  async getConversations() {\n    return await this.getMemory('conversations') || [];\n  }\n\n  // Decision tracking\n  async addDecision(decision, reasoning, context) {\n    const decisions = await this.getMemory('decisions') || [];\n    decisions.push({\n      id: `dec_${Date.now()}`,\n      timestamp: new Date().toISOString(),\n      decision,\n      reasoning,\n      context\n    });\n    \n    // Keep only last 100 decisions\n    if (decisions.length > 100) {\n      decisions.splice(0, decisions.length - 100);\n    }\n    \n    await this.setMemory('decisions', decisions);\n  }\n\n  async getDecisions() {\n    return await this.getMemory('decisions') || [];\n  }\n\n  // File tracking\n  async addGeneratedFiles(files) {\n    const allFiles = await this.getMemory('generated_files') || [];\n    const newFiles = files.map(file => ({\n      path: file.path,\n      timestamp: new Date().toISOString(),\n      size: file.content?.length || 0\n    }));\n    \n    allFiles.push(...newFiles);\n    await this.setMemory('generated_files', allFiles);\n  }\n\n  async getGeneratedFiles() {\n    return await this.getMemory('generated_files') || [];\n  }\n\n  // Access to project context\n  async getProjectRequirements() {\n    return await this.projectContext.getRequirements();\n  }\n\n  async getProjectArtifact(type) {\n    return await this.projectContext.getArtifact(type);\n  }\n\n  async setProjectArtifact(type, data) {\n    return await this.projectContext.setArtifact(type, data);\n  }\n}",
