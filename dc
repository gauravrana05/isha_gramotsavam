s(analysis.relationships);\n    \n    const files = [\n      {\n        path: 'code/prisma/schema.prisma',\n        content: prismaSchema\n      },\n      {\n        path: 'code/src/lib/db.ts',\n        content: dbConnection\n      },\n      {\n        path: 'code/prisma/seed.ts',\n        content: seedFile\n      },\n      {\n        path: 'database/database-design.md',\n        content: this.generateDatabaseDocumentation(analysis)\n      },\n      {\n        path: 'database/entity-relationship-diagram.md',\n        content: this.generateERDDocumentation(analysis)\n      }\n    ];\n    \n    await this.rememberDecision(\n      `Generated database schema with ${analysis.entities.length} entities`,\n      `Analyzed requirements and identified entities: ${analysis.entities.map(e => e.name).join(', ')}`,\n      { entities: analysis.entities.length, relationships: analysis.relationships.length }\n    );\n    \n    return {\n      files,\n      schema: {\n        entities: analysis.entities,\n        relationships: analysis.relationships,\n        prismaSchema\n      },\n      success: true\n    };\n  }\n\n  enhanceEntitiesWithArchitecture(entities, architecture) {\n    // If architecture specifies additional entities or constraints, add them\n    if (architecture.entities) {\n      for (const archEntity of architecture.entities) {\n        const existing = entities.find(e => e.name === archEntity.name);\n        if (!existing) {\n          entities.push({\n            name: archEntity.name,\n            fields: this.koshContext.generateEntityFields(archEntity.name.toLowerCase()),\n            tableName: archEntity.name.toLowerCase()\n          });\n        }\n      }\n    }\n    \n    return entities;\n  }\n\n  generateDatabaseConnection() {\n    return `// Database Connection - Generated by KOSH\nimport { PrismaClient } from '@prisma/client';\n\nconst globalForPrisma = globalThis as unknown as {\n  prisma: PrismaClient | undefined;\n};\n\nexport const db = globalForPrisma.prisma ?? new PrismaClient();\n\nif (process.env.NODE_ENV !== 'production') globalForPrisma.prisma = db;`;\n  }\n\n  generateSeedFile(entities) {\n    return `// Database Seed - Generated by KOSH\nimport { PrismaClient } from '@prisma/client';\n\nconst prisma = new PrismaClient();\n\nasync function main() {\n  console.log('🌱 Seeding database...');\n  \n  // Create sample users\n  const user1 = await prisma.user.create({\n    data: {\n      name: 'John Doe',\n      email: 'john@example.com',\n      role: 'USER',\n    },\n  });\n  \n  const user2 = await prisma.user.create({\n    data: {\n      name: 'Jane Smith',\n      email: 'jane@example.com',\n      role: 'ADMIN',\n    },\n  });\n  \n  console.log('✅ Database seeded successfully');\n}\n\nmain()\n  .catch((e) => {\n    console.error('❌ Error seeding database:', e);\n    process.exit(1);\n  })\n  .finally(async () => {\n    await prisma.$disconnect();\n  });`;\n  }\n\n  generateDatabaseDocumentation(analysis) {\n    return `# Database Design Documentation\n\n*Generated by KOSH Agent*\n\n## Overview\n\nThis database schema was designed based on the project requirements and supports the following entities:\n\n${analysis.entities.map(entity => `- **${entity.name}**: ${this.getEntityDescription(entity)}`).join('\\n')}\n\n## Entities\n\n${analysis.entities.map(entity => `\n### ${entity.name}\n\n**Table Name**: \\`${entity.tableName}\\`\n\n**Fields**:\n${entity.fields.map(field => `- \\`${field.name}\\` (${field.type}): ${this.getFieldDescription(field)}`).join('\\n')}\n`).join('\\n')}\n\n## Relationships\n\n${analysis.relationships.map(rel => `- **${rel.from}** ${rel.type} **${rel.to}** (${rel.field})`).join('\\n')}\n\n## Indexes\n\nThe following indexes are recommended for optimal performance:\n\n${analysis.entities.map(entity => `- \\`${entity.tableName}_id_idx\\` on \\`${entity.tableName}.id\\``).join('\\n')}\n\n## Migration Commands\n\n\\`\\`\\`bash\n# Generate Prisma client\nnpm run db:generate\n\n# Push schema to database\nnpm run db:push\n\n# Run migrations\nnpm run db:migrate\n\n# Seed database\nnpm run db:seed\n\\`\\`\\`\n`;\n  }\n\n  generateERDDocumentation(analysis) {\n    return `# Entity Relationship Diagram\n\n*Generated by KOSH Agent*\n\n## Database Schema Visualization\n\n\\`\\`\\`mermaid\nerDiagram\n${analysis.entities.map(entity => `\n    ${entity.name.toUpperCase()} {\n${entity.fields.map(field => `        ${field.type} ${field.name}`).join('\\n')}\n    }`).join('\\n')}\n    \n${analysis.relationships.map(rel => {\n  const relationshipType = rel.type === 'oneToMany' ? '||--o{' : '}o--||';\n  return `    ${rel.from.toUpperCase()} ${relationshipType} ${rel.to.toUpperCase()} : ${rel.field}`;\n}).join('\\n')}\n\\`\\`\\`\n\n## Relationship Details\n\n${analysis.relationships.map(rel => `\n### ${rel.from} → ${rel.to}\n\n- **Type**: ${rel.type}\n- **Field**: ${rel.field}\n- **Description**: ${this.getRelationshipDescription(rel)}\n`).join('\\n')}\n`;\n  }\n\n  getEntityDescription(entity) {\n    const descriptions = {\n      'User': 'System users with authentication and profile information',\n      'Post': 'Blog posts or articles with content and metadata',\n      'Comment': 'User comments on posts with threading support',\n      'Task': 'Project tasks with status tracking and assignment',\n      'Project': 'Project containers for organizing tasks and resources',\n      'Category': 'Content categorization and tagging system',\n      'File': 'File attachments and media storage',\n      'Notification': 'System notifications and alerts'\n    };\n    \n    return descriptions[entity.name] || 'Application entity';\n  }\n\n  getFieldDescription(field) {\n    if (field.name === 'id') return 'Unique identifier';\n    if (field.name === 'createdAt') return 'Creation timestamp';\n    if (field.name === 'updatedAt') return 'Last update timestamp';\n    if (field.name.endsWith('Id')) return 'Foreign key reference';\n    if (field.name === 'email') return 'User email address';\n    if (field.name === 'name') return 'Display name';\n    if (field.name === 'title') return 'Title or heading';\n    if (field.name === 'content') return 'Main content or description';\n    if (field.name === 'status') return 'Current status';\n    if (field.name === 'priority') return 'Priority level';\n    \n    return 'Entity field';\n  }\n\n  getRelationshipDescription(rel) {\n    return `A ${rel.from} can have ${rel.type === 'oneToMany' ? 'multiple' : 'one'} ${rel.to}`;\n  }\n}",
