mple Project',\n      description: 'A sample project for testing',\n      userId: user1.id,\n    },\n  });\n  ` : ''}\n  \n  ${entities.includes('Task') ? `\n  // Create sample tasks\n  await prisma.task.create({\n    data: {\n      title: 'Sample Task',\n      description: 'A sample task for testing',\n      status: 'TODO',\n      priority: 'MEDIUM',\n      userId: user1.id,\n      assigneeId: user1.id,\n      ${entities.includes('Project') ? 'projectId: project.id,' : ''}\n    },\n  });\n  ` : ''}\n  \n  console.log('✅ Database seeded successfully');\n}\n\nmain()\n  .catch((e) => {\n    console.error('❌ Error seeding database:', e);\n    process.exit(1);\n  })\n  .finally(async () => {\n    await prisma.$disconnect();\n  });`;\n  }\n\n  generateDatabaseDocumentation(entities, relationships) {\n    return `# Database Design Documentation\n\n*Generated by KOSH Agent*\n\n## Overview\n\nThis database schema supports the following entities:\n\n${entities.map(entity => `- **${entity}**: ${this.getEntityDescription(entity)}`).join('\\n')}\n\n## Entities\n\n${entities.map(entity => `\n### ${entity}\n\n**Table Name**: \\`${entity.toLowerCase()}\\`\n\n**Fields**:\n${this.generateEntityFields(entity).map(field => `- \\`${field.name}\\` (${field.type}): ${this.getFieldDescription(field)}`).join('\\n')}\n`).join('\\n')}\n\n## Relationships\n\n${relationships.map(rel => `- **${rel.from}** ${rel.type} **${rel.to}** (${rel.field})`).join('\\n')}\n\n## Security Features\n\n- **Audit Logging**: All changes tracked in AuditLog table\n- **Role-Based Access**: User roles (USER, ADMIN, SUPER_ADMIN)\n- **Data Encryption**: Sensitive fields encrypted at rest\n\n## Performance Optimizations\n\n- **Indexes**: Automatic indexes on foreign keys and unique fields\n- **Query Optimization**: Efficient relationship queries\n- **Connection Pooling**: Prisma connection pooling enabled\n\n## Migration Commands\n\n\\`\\`\\`bash\n# Generate Prisma client\nnpm run db:generate\n\n# Push schema to database\nnpm run db:push\n\n# Run migrations\nnpm run db:migrate\n\n# Seed database\nnpm run db:seed\n\\`\\`\\`\n`;\n  }\n\n  generateERDDocumentation(entities, relationships) {\n    return `# Entity Relationship Diagram\n\n*Generated by KOSH Agent*\n\n## Database Schema Visualization\n\n\\`\\`\\`mermaid\nerDiagram\n${entities.map(entity => `\n    ${entity.toUpperCase()} {\n${this.generateEntityFields(entity).map(field => `        ${field.type} ${field.name}`).join('\\n')}\n    }`).join('\\n')}\n    \n${relationships.map(rel => {\n  const relationshipType = rel.type === 'oneToMany' ? '||--o{' : '}o--||';\n  return `    ${rel.from.toUpperCase()} ${relationshipType} ${rel.to.toUpperCase()} : ${rel.field}`;\n}).join('\\n')}\n\\`\\`\\`\n\n## Relationship Details\n\n${relationships.map(rel => `\n### ${rel.from} → ${rel.to}\n\n- **Type**: ${rel.type}\n- **Field**: ${rel.field}\n- **Description**: A ${rel.from} can have ${rel.type === 'oneToMany' ? 'multiple' : 'one'} ${rel.to}\n`).join('\\n')}\n`;\n  }\n\n  getEntityDescription(entity) {\n    const descriptions = {\n      'User': 'System users with authentication and profile information',\n      'Post': 'Blog posts or articles with content and metadata',\n      'Comment': 'User comments on posts with threading support',\n      'Task': 'Project tasks with status tracking and assignment',\n      'Project': 'Project containers for organizing tasks and resources',\n      'Category': 'Content categorization and tagging system',\n      'File': 'File attachments and media storage',\n      'Notification': 'System notifications and alerts',\n      'Team': 'User groups and team management'\n    };\n    \n    return descriptions[entity] || 'Application entity';\n  }\n\n  getFieldDescription(field) {\n    if (field.name === 'id') return 'Unique identifier';\n    if (field.name === 'createdAt') return 'Creation timestamp';\n    if (field.name === 'updatedAt') return 'Last update timestamp';\n    if (field.name.endsWith('Id')) return 'Fore