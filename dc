oot.ts',\n      content: this.generateRootRouter(schema.entities)\n    });\n\n    return { files, success: true };\n  }\n\n  extractFeatureFromTask(task) {\n    const features = ['authentication', 'projects', 'tasks', 'comments', 'notifications', 'files', 'advanced'];\n    return features.find(feature => task.toLowerCase().includes(feature)) || 'general';\n  }\n\n  generateAPIPlanning(entities, features) {\n    const apis = {};\n    \n    for (const feature of features) {\n      apis[feature] = this.generateFeatureAPIs(feature, entities);\n    }\n    \n    return apis;\n  }\n\n  generateFeatureAPIs(feature, entities) {\n    const featureAPIs = {\n      authentication: ['login', 'register', 'logout', 'getSession', 'updateProfile'],\n      projects: ['getAll', 'getById', 'create', 'update', 'delete', 'getMembers'],\n      tasks: ['getAll', 'getById', 'create', 'update', 'delete', 'updateStatus'],\n      comments: ['getByTask', 'create', 'update', 'delete'],\n      notifications: ['getAll', 'markAsRead', 'markAllAsRead'],\n      files: ['upload', 'download', 'delete', 'getByEntity'],\n      advanced: ['realTimeUpdates', 'collaboration', 'analytics']\n    };\n    \n    return featureAPIs[feature] || ['getAll', 'create', 'update', 'delete'];\n  }\n\n  generateRootRouter(entities) {\n    const imports = entities.map(entity => \n      `import { ${entity.name.toLowerCase()}Router } from \"~/server/api/routers/${entity.name.toLowerCase()}\";`\n    ).join('\\n');\n    \n    const routers = entities.map(entity => \n      `  ${entity.name.toLowerCase()}: ${entity.name.toLowerCase()}Router,`\n    ).join('\\n');\n    \n    return `import { createTRPCRouter } from \"~/server/api/trpc\";\n${imports}\n\nexport const appRouter = createTRPCRouter({\n${routers}\n});\n\nexport type AppRouter = typeof appRouter;`;\n  }\n\n  generateTRPCConfig() {\n    return `import { initTRPC, TRPCError } from \"@trpc/server\";\nimport { type CreateNextContextOptions } from \"@trpc/server/adapters/next\";\nimport { type Session } from \"next-auth\";\nimport { getServerSession } from \"next-auth/next\";\nimport { authOptions } from \"~/server/auth\";\nimport { db } from \"~/lib/db\";\nimport superjson from \"superjson\";\n\ntype CreateContextOptions = {\n  session: Session | null;\n};\n\nconst createInnerTRPCContext = (opts: CreateContextOptions) => {\n  return {\n    session: opts.session,\n    db,\n  };\n};\n\nexport const createTRPCContext = async (opts: CreateNextContextOptions) => {\n  const { req, res } = opts;\n  const session = await getServerSession(req, res, authOptions);\n\n  return createInnerTRPCContext({\n    session,\n  });\n};\n\nconst t = initTRPC.context<typeof createTRPCContext>().create({\n  transformer: superjson,\n});\n\nexport const createTRPCRouter = t.router;\nexport const publicProcedure = t.procedure;\n\nexport const protectedProcedure = t.procedure.use(({ ctx, next }) => {\n  if (!ctx.session || !ctx.session.user) {\n    throw new TRPCError({ code: \"UNAUTHORIZED\" });\n  }\n  return next({\n    ctx: {\n      session: { ...ctx.session, user: ctx.session.user },\n      db: ctx.db,\n    },\n  });\n});`;\n  }\n\n  generateEntityRouterPlaceholder(entity) {\n    return `import { z } from \"zod\";\nimport { createTRPCRouter, protectedProcedure, publicProcedure } from \"~/server/api/trpc\";\n\nexport const ${entity.name.toLowerCase()}Router = createTRPCRouter({\n  // TODO: Implement ${entity.name} CRUD operations\n  getAll: protectedProcedure.query(async ({ ctx }) => {\n    // Implementation pending\n    return [];\n  }),\n  \n  create: protectedProcedure\n    .input(z.object({\n      // TODO: Add ${entity.name} fields\n    }))\n    .mutation(async ({ ctx, input }) => {\n      // Implementation pending\n      return { success: true };\n    }),\n});`;\n  }\n\n  generateEntityRouter(entity) {\n    const entityLower = entity.name.toLowerCase();\n    const fields = entity.fields.filter(f => !['id', 'createdAt', 'updatedAt'].includes(f.name));\n    \n    const inputFields = fields.map(field => {\n      const optional = field.type.includes('?') ? '.optional()' : '';\n      const zodType = this.getZodType(field.type);\n      return `      ${field.name}: z.${zodType}()${optional},`;\n    }).join('\\n');\n    \n    return `import { z } from \"zod\";\nimport { createTRPCRouter, protectedProcedure } from \"~/server/api/trpc\";\n\nexport const ${entityLower}Router = createTRPCRouter({\n  getAll: protectedProcedure.query(async ({ ctx }) => {\n    return ctx.db.${entityLower}.findMany({\n      include: {\n        // Add relations as needed\n      },\n      orderBy: { createdAt: \"desc\" },\n    });\n  }),\n\n  getById: protectedProcedure\n    .input(z.object({ id: z.string() }))\n    .query(async ({ ctx, input }) => {\n      return ctx.db.${entityLower}.findUnique({\n        where: { id: input.id },\n        include: {\n          // Add relations as needed\n        },\n      });\n    }),\n\n  create: protectedProcedure\n    .input(z.object({\n${inputFields}\n    }))\n    .mutation(async ({ ctx, input }) => {\n      return ctx.db.${entityLower}.create({\n        data: {\n          ...input,\n          userId: ctx.session.user.id, // If entity has userId\n        },\n      });\n    }),\n\n  update: protectedProcedure\n    .input(z.object({\n      id: z.string(),\n${inputFields}\n    }))\n    .mutation(async ({ ctx, input }) => {\n      const { id, ...updateData } = input;\n      \n      return ctx.db.${entityLower}.update({\n        where: { id },\n        data: updateData,\n      });\n    }),\n\n  delete: protectedProcedure\n    .input(z.object({ id: z.string() }))\n    .mutation(async ({ ctx, input }) => {\n      return ctx.db.${entityLower}.delete({\n        where: { id: input.id },\n      });\n    }),\n});`;\n  }\n\n  getZodType(prismaType) {\n    if (prismaType.includes('String')) return 'string';\n    if (prismaType.includes('Int')) return 'number';\n    if (prismaType.includes('Boolean')) return 'boolean';\n    if (prismaType.includes('DateTime')) return 'date';\n    return 'string';\n  }\n\n  generateAuthConfig() {\n    return `import { PrismaAdapter } from \"@next-auth/prisma-adapter\";\nimport { type GetServerSidePropsContext } from \"next\";\nimport {\n  getServerSession,\n  type DefaultSession,\n  type NextAuthOptions,\n} from \"next-auth\";\nimport GoogleProvider from \"next-auth/providers/google\";\nimport GitHubProvider from \"next-auth/providers/github\";\nimport { db } from \"~/lib/db\";\n\ndeclare module \"next-auth\" {\n  interface Session extends DefaultSession {\n    user: {\n      id: string;\n      role: string;\n    } & DefaultSession[\"user\"];\n  }\n}\n\nexport const authOptions: NextAuthOptions = {\n  callbacks: {\n    session: ({ session, token }) => ({\n      ...session,\n      user: {\n        ...session.user,\n        id: token.sub,\n      },\n    }),\n  },\n  adapter: PrismaAdapter(db),\n  providers: [\n    GoogleProvider({\n      clientId: process.env.GOOGLE_CLIENT_ID!,\n      clientSecret: process.env.GOOGLE_CLIENT_SECRET!,\n    }),\n    GitHubProvider({\n      clientId: process.env.GITHUB_CLIENT_ID!,\n      clientSecret: process.env.GITHUB_CLIENT_SECRET!,\n    }),\n  ],\n};\n\nexport const getServerAuthSession = (ctx: {\n  req: GetServerSidePropsContext[\"req\"];\n  res: GetServerSidePropsContext[\"res\"];\n}) => {\n  return getServerSession(ctx.req, ctx.res, authOptions);\n};`;\n  }\n\n  generateFeatureImplementation(featureName, schema) {\n    // This would contain feature-specific implementation\n    return {\n      router: `// ${featureName} feature implementation - Generated by MOOL\n// Full implementation would be generated here based on feature requirements`,\n      documentation: `# ${featureName} Feature Implementation\n\n*Generated by MOOL Agent*\n\n## API Endpoints\n\n- Implementation details for ${featureName} feature\n- Business logic and validation rules\n- Integration with database schema\n`\n    };\n  }\n\n  generateAPIPlanningDoc(apis, features) {\n    return `# API Planning Document\n\n*Generated by MOOL Agent*\n\n## Feature APIs\n\n${Object.entries(apis).map(([feature, endpoints]) => `\n### ${feature}\n\n${endpoints.map(endpoint => `- **${endpoint}**: API endpoint for ${feature}`).join('\\n')}\n`).join('\\n')}\n\n## Implementation Strategy\n\n1. **Phase 1**: Core CRUD operations for all entities\n2. **Phase 2**: Feature-specific business logic\n3. **Phase 3**: Advanced features and optimizations\n4. **Phase 4**: Real-time and collaboration features\n`;\n  }\n\n  generateFeatureBreakdownDoc(features, apis) {\n    return `# Feature Breakdown\n\n*Generated by MOOL Agent*\n\n## Development Order\n\n${features.map((feature, index) => `\n### ${index + 1}. ${feature}\n\n**Priority**: ${index === 0 ? 'High' : index < 3 ? 'Medium' : 'Low'}\n**APIs**: ${apis[feature]?.length || 0} endpoints\n**Dependencies**: ${this.getFeatureDependencies(feature).join(', ') || 'None'}\n`).join('\\n')}\n\n## Implementation Notes\n\n- Authentication must be implemented first\n- Each feature builds on previous foundations\n- Real-time features require WebSocket setup\n`;\n  }\n\n  getFeatureDependencies(feature) {\n    const dependencies = {\n      projects: ['authentication'],\n      tasks: ['authentication', 'projects'],\n      comments: ['authentication', 'tasks'],\n      notifications: ['authentication'],\n      files: ['authentication'],\n      advanced: ['authentication', 'projects', 'tasks']\n    };\n    \n    return dependencies[feature] || [];\n  }\n}",
