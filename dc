                "file_text": "import Redis from 'ioredis';\n\nexport class ProjectContext {\n  constructor(projectId) {\n    this.projectId = projectId;\n    this.redis = new Redis(process.env.REDIS_URL || 'redis://localhost:6379');\n  }\n\n  // Phase management\n  async setPhase(phase) {\n    await this.redis.hset(`project:${this.projectId}`, 'current_phase', phase);\n    await this.redis.hset(`project:${this.projectId}`, 'phase_timestamp', new Date().toISOString());\n    console.log(`📍 PROJECT ${this.projectId}: Entered Phase ${phase}`);\n  }\n\n  async getCurrentPhase() {\n    return await this.redis.hget(`project:${this.projectId}`, 'current_phase') || 'foundation';\n  }\n\n  // Requirements management\n  async setRequirements(requirements) {\n    await this.redis.hset(`project:${this.projectId}`, 'requirements', JSON.stringify(requirements));\n  }\n\n  async getRequirements() {\n    const data = await this.redis.hget(`project:${this.projectId}`, 'requirements');\n    return data ? JSON.parse(data) : null;\n  }\n\n  // Agent output storage\n  async setAgentOutput(agentName, output) {\n    await this.redis.hset(`project:${this.projectId}:outputs`, agentName, JSON.stringify({\n      output,\n      timestamp: new Date().toISOString(),\n      phase: await this.getCurrentPhase()\n    }));\n  }\n\n  async getAgentOutput(agentName) {\n    const data = await this.redis.hget(`project:${this.projectId}:outputs`, agentName);\n    return data ? JSON.parse(data).output : null;\n  }\n\n  // Feature tracking for Phase 7\n  async setFeatureStatus(featureName, status, agentName) {\n    await this.redis.hset(`project:${this.projectId}:features`, featureName, JSON.stringify({\n      status,\n      lastAgent: agentName,\n      timestamp: new Date().toISOString()\n    }));\n  }\n\n  async getFeatureStatus(featureName) {\n    const data = await this.redis.hget(`project:${this.projectId}:features`, featureName);\n    return data ? JSON.parse(data) : { status: 'pending' };\n  }\n\n  async getAllFeatures() {\n    const features = await this.redis.hgetall(`project:${this.projectId}:features`);\n    const result = {};\n    for (const [name, data] of Object.entries(features)) {\n      result[name] = JSON.parse(data);\n    }\n    return result;\n  }\n\n  // Coordination system\n  async createRequest(fromAgent, toAgent, requestType, message) {\n    const requestId = `req_${Date.now()}_${Math.random().toString(36).substr(2, 9)}`;\n    \n    await this.redis.hset(`project:${this.projectId}:requests`, requestId, JSON.stringify({\n      id: requestId,\n      fromAgent,\n      toAgent,\n      requestType,\n      message,\n      status: 'pending',\n      timestamp: new Date().toISOString()\n    }));\n\n    console.log(`🤖 ${fromAgent.toUpperCase()} → ${toAgent.toUpperCase()}: ${message}`);\n    return requestId;\n  }\n\n  async respondToRequest(requestId, fromAgent, response, status = 'completed') {\n    const requestData = await this.redis.hget(`project:${this.projectId}:requests`, requestId);\n    if (!requestData) {\n      throw new Error(`Request ${requestId} not found`);\n    }\n\n    const request = JSON.parse(requestData);\n    request.response = response;\n    request.status = status;\n    request.responseTimestamp = new Date().toISOString();\n    request.respondedBy = fromAgent;\n\n    await this.redis.hset(`project:${this.projectId}:requests`, requestId, JSON.stringify(request));\n    \n    console.log(`✅ ${fromAgent.toUpperCase()} → ${request.fromAgent.toUpperCase()}: ${response}`);\n    return request;\n  }\n\n  async getRequest(requestId) {\n    const data = await this.redis.hget(`project:${this.projectId}:requests`, requestId);\n    return data ? JSON.parse(data) : null;\n  }\n\n  // Project initialization\n  async initialize(requirements) {\n    await this.redis.hset(`project:${this.projectId}`, 'created', new Date().toISOString());\n    await this.setRequirements(requirements);\n    await this.setPhase('foundation');\n    \n    // Initialize feature list based on requirements\n    const features = this.extractFeaturesFromRequirements(requirements);\n    for (const feature of features) {\n      await this.setFeatureStatus(feature, 'pending', 'system');\n    }\n    \n    console.log(`🚀 PROJECT ${this.projectId}: Initialized with ${features.length} features`);\n  }\n\n  extractFeaturesFromRequirements(requirements) {\n    const features = ['authentication']; // Always needed\n    \n    const text = requirements.toLowerCase();\n    \n    if (text.includes('project') || text.includes('workspace')) features.push('projects');\n    if (text.includes('task') || text.includes('todo')) features.push('tasks');\n    if (text.includes('comment') || text.includes('discussion')) features.push('comments');\n    if (text.includes('notification') || text.includes('alert')) features.push('notifications');\n    if (text.includes('file') || text.includes('upload') || text.includes('attachment')) features.push('files');\n    \n    // Advanced features\n    if (text.includes('real-time') || text.includes('live') || text.includes('collaboration')) features.push('advanced');\n    \n    return features;\n  }\n\n  // Cleanup\n  async cleanup() {\n    const keys = await this.redis.keys(`*:${this.projectId}*`);\n    if (keys.length > 0) {\n      await this.redis.del(...keys);\n    }\n  }\n}",
