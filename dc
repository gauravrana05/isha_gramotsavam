                "file_text": "import { AgentContext } from '../context/agent-context.js';\nimport { DependencyResolver } from '../context/dependency-resolver.js';\nimport { writeFileSync, mkdirSync, existsSync } from 'fs';\nimport { join, dirname } from 'path';\n\nexport class BaseAgent {\n  constructor(agentName) {\n    this.name = agentName;\n    this.context = null;\n    this.dependencyResolver = null;\n  }\n\n  // Initialize context for each execution\n  async initializeContext(projectId) {\n    this.context = new AgentContext(this.name, projectId);\n    this.dependencyResolver = new DependencyResolver(projectId);\n    \n    // Load conversation history\n    this.conversationHistory = await this.context.getConversations();\n    this.previousDecisions = await this.context.getDecisions();\n    this.generatedFiles = await this.context.getGeneratedFiles();\n  }\n\n  // Main execution method - to be overridden by specific agents\n  async execute(task, requirements, projectId) {\n    await this.initializeContext(projectId);\n    \n    console.log(`🤖 ${this.name.toUpperCase()}: Starting task \"${task}\"`);\n    \n    // Analyze what dependencies I need\n    const needs = await this.analyzeNeeds(task, requirements);\n    \n    // Resolve dependencies (may trigger other agents)\n    const dependencies = await this.resolveDependencies(needs);\n    \n    // Generate output with dependencies\n    const result = await this.generateWithDependencies(task, requirements, dependencies);\n    \n    // Write files to disk\n    if (result.files && result.files.length > 0) {\n      await this.writeFiles(result.files, projectId);\n      await this.context.addGeneratedFiles(result.files);\n    }\n    \n    // Remember this conversation\n    await this.context.addConversation(task, requirements, result);\n    \n    console.log(`✅ ${this.name.toUpperCase()}: Completed task with ${result.files?.length || 0} files`);\n    \n    return result;\n  }\n\n  // Analyze what dependencies this agent needs - to be overridden\n  async analyzeNeeds(task, requirements) {\n    return []; // Default: no dependencies\n  }\n\n  // Resolve dependencies using the dependency resolver\n  async resolveDependencies(needs) {\n    if (needs.length === 0) return {};\n    \n    return await this.dependencyResolver.resolve(this.name, needs);\n  }\n\n  // Generate output with resolved dependencies - to be overridden\n  async generateWithDependencies(task, requirements, dependencies) {\n    return { files: [], success: true };\n  }\n\n  // Write files to the project directory\n  async writeFiles(files, projectId) {\n    const projectPath = join(process.cwd(), 'mcp-server', 'projects', projectId);\n    \n    for (const file of files) {\n      const fullPath = join(projectPath, file.path);\n      const dir = dirname(fullPath);\n      \n      // Ensure directory exists\n      if (!existsSync(dir)) {\n        mkdirSync(dir, { recursive: true });\n      }\n      \n      // Write file\n      writeFileSync(fullPath, file.content);\n      console.log(`📁 ${this.name.toUpperCase()}: Created ${file.path}`);\n    }\n  }\n\n  // Get intelligent context for decision making\n  async getIntelligentContext() {\n    return {\n      // Project-wide context\n      requirements: await this.context.getProjectRequirements(),\n      \n      // Agent-specific context\n      previousTasks: this.conversationHistory,\n      previousDecisions: this.previousDecisions,\n      generatedFiles: this.generatedFiles,\n      \n      // Available artifacts from other agents\n      availableArtifacts: await this.getAvailableArtifacts()\n    };\n  }\n\n  async getAvailableArtifacts() {\n    const artifacts = {};\n    const artifactTypes = [\n      'system-architecture', 'database-schema', 'design-tokens', \n      'apis', 'ui-components', 'security-audit'\n    ];\n    \n    for (const type of artifactTypes) {\n      const artifact = await this.context.getProjectArtifact(type);\n      if (artifact) {\n        artifacts[type] = artifact;\n      }\n    }\n    \n    return artifacts;\n  }\n\n  // Helper method to check if task involves certain keywords\n  taskInvolves(task, requirements, keywords) {\n    const text = `${task} ${requirements}`.toLowerCase();\n    return keywords.some(keyword => text.includes(keyword));\n  }\n\n  // Helper method to remember decisions\n  async rememberDecision(decision, reasoning, context = {}) {\n    await this.context.addDecision(decision, reasoning, context);\n  }\n\n  // Helper method to get similar previous tasks\n  async getSimilarTasks(task) {\n    const conversations = await this.context.getConversations();\n    return conversations.filter(conv => \n      conv.task.toLowerCase().includes(task.toLowerCase()) ||\n      task.toLowerCase().includes(conv.task.toLowerCase())\n    );\n  }\n}",
