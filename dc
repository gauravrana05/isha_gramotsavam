DharAgent())\n    };\n\n    if (!agentMap[agentName]) {\n      throw new Error(`Unknown agent: ${agentName}`);\n    }\n\n    const agent = await agentMap[agentName]();\n    \n    // Generate appropriate task for the need\n    const task = this.generateTaskForNeed(need);\n    const requirements = await this.context.getRequirements();\n    \n    console.log(`🚀 ${agentName.toUpperCase()}: Executing \"${task}\"`);\n    const result = await agent.execute(task, requirements, this.projectId);\n    \n    // Extract and cache the needed data\n    const extractedData = this.extractNeededData(result, need.type);\n    await this.context.setArtifact(need.type, extractedData);\n    \n    return extractedData;\n  }\n\n  generateTaskForNeed(need) {\n    const taskMap = {\n      'system-architecture': 'Design system architecture',\n      'database-schema': 'Design database schema',\n      'design-system': 'Create design system',\n      'design-tokens': 'Generate design tokens',\n      'apis': 'Build backend APIs',\n      'ui-components': 'Create UI components',\n      'security-audit': 'Perform security audit',\n      'performance-audit': 'Analyze performance',\n      'testing-setup': 'Setup testing infrastructure'\n    };\n    \n    return taskMap[need.type] || `Generate ${need.type}`;\n  }\n\n  extractNeededData(result, needType) {\n    // Extract specific data based on need type\n    if (needType === 'database-schema' && result.schema) {\n      return result.schema;\n    }\n    \n    if (needType === 'design-tokens' && result.designTokens) {\n      return result.designTokens;\n    }\n    \n    if (needType === 'apis' && result.apis) {\n      return result.apis;\n    }\n    \n    // Default: return the whole result\n    return result;\n  }\n}",
