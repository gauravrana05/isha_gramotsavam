ance-review': 'Optimize performance'\n    };\n    \n    const task = taskMap[requestType] || `Handle ${requestType}`;\n    \n    // Trigger the agent automatically\n    const agent = this.getAgent(agentName);\n    return await agent.execute(task, message, this.projectId);\n  }\n}\n```\n\n### **5. Specific Agent Implementations**\n\n#### **Kosh Agent (Database) - Building Block**\n```javascript\nclass KoshAgent extends BoundedIntelligentAgent {\n  constructor() {\n    super('kosh', 'database', ['schema', 'entities', 'relationships'], ['no-apis', 'no-ui']);\n  }\n  \n  async performIntelligentWork(task, requirements, previousWork) {\n    console.log(`🗄️ KOSH: Analyzing requirements for database design...`);\n    \n    // Use LLM intelligence to analyze requirements\n    const entities = this.analyzeEntitiesFromRequirements(requirements);\n    const relationships = this.inferRelationships(entities);\n    \n    // Use architecture from PAL if available\n    if (previousWork.architecture) {\n      console.log(`📊 KOSH: Using architecture constraints from PAL`);\n      entities = this.enhanceWithArchitecture(entities, previousWork.architecture);\n    }\n    \n    // Generate schema intelligently\n    const schema = this.generatePrismaSchema(entities, relationships);\n    \n    return {\n      entities,\n      relationships,\n      schema,\n      files: this.generateSchemaFiles(schema)\n    };\n  }\n  \n  analyzeEntitiesFromRequirements(requirements) {\n    // LLM reasoning: \"For a task management system, I need...\"\n    const entities = [];\n    \n    if (this.requirementsInclude(requirements, ['user', 'account', 'auth'])) {\n      entities.push(this.createUserEntity());\n    }\n    \n    if (this.requirementsInclude(requirements, ['task', 'todo', 'item'])) {\n      entities.push(this.createTaskEntity());\n    }\n    \n    if (this.requirementsInclude(requirements, ['project', 'workspace'])) {\n      entities.push(this.createProjectEntity());\n    }\n    \n    // Continue LLM-style reasoning...\n    return entities;\n  }\n}\n```\n\n#### **Mool Agent (Backend) - Building Block**\n```javascript\nclass MoolAgent extends BoundedIntelligentAgent {\n  constructor() {\n    super('mool', 'backend', ['apis', 'business-logic', 'auth'], ['no-ui', 'no-design']);\n  }\n  \n  async performIntelligentWork(task, requirements, previousWork) {\n    console.log(`⚙️ MOOL: Building backend APIs...`);\n    \n    // Must have schema from KOSH\n    if (!previousWork.schema) {\n      throw new Error('MOOL needs database schema from KOSH first');\n    }\n    \n    // Use LLM intelligence to generate APIs based on schema\n    const apis = this.generateAPIsFromSchema(previousWork.schema);\n    \n    // Add business logic based on requirements\n    const businessLogic = this.generateBusinessLogic(requirements, previousWork.schema);\n    \n    return {\n      apis,\n      businessLogic,\n      files: this.generateAPIFiles(apis, businessLogic)\n    };\n  }\n  \n  generateAPIsFromSchema(schema) {\n    const apis = [];\n    \n    // For each entity in schema, create CRUD APIs\n    for (const entity of schema.entities) {\n      apis.push({\n        name: `${entity.name.toLowerCase()}Router`,\n        operations: ['create', 'read', 'update', 'delete'],\n        entity: entity.name,\n        fields: entity.fields\n      });\n    }\n    \n    return apis;\n  }\n}\n```\n\n### **6. Task Persistence & Context Flow**\n\n```javascript\n// How context flows between tasks:\n\n// Task 1: User runs \"kosh --task 'Design schema' --requirements 'Blog app'\"\n// → Kosh analyzes, creates User, Post, Comment entities\n// → Saves to Redis: project:blog:state:database_schema = {entities: [...]}\n\n// Task 2: User runs \"mool --task 'Build APIs' --requirements 'Blog APIs'\"\n// → Mool loads: database_schema from Redis\n// → Sees User, Post, Comment entities\n// → Generates userRouter, postRouter, commentRouter\n// → Saves to Redis: project:blog:state:backend_apis = {routers: [...]}\n\