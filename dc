                "file_text": "import { ProjectContext } from '../context/project-context.js';\n\nexport class WorkflowOrchestrator {\n  constructor(projectId) {\n    this.projectId = projectId;\n    this.context = new ProjectContext(projectId);\n    this.agents = new Map();\n  }\n\n  registerAgent(name, agent) {\n    this.agents.set(name, agent);\n  }\n\n  async executePhase1Foundation(requirements) {\n    console.log('🏗️  PHASE 1: Project Foundation');\n    await this.context.setPhase('foundation');\n\n    // init → pal (architecture) → kalp (design) → bandh (security)\n    const palResult = await this.executeAgent('pal', 'Design system architecture', requirements);\n    const kalpResult = await this.executeAgent('kalp', 'Create design system', requirements);\n    const bandhResult = await this.executeAgent('bandh', 'Security architecture', requirements);\n\n    return { architecture: palResult, design: kalpResult, security: bandhResult };\n  }\n\n  async executePhase2DatabaseDesign(requirements) {\n    console.log('🗄️  PHASE 2: Database Design + Setup with Coordination');\n    await this.context.setPhase('database');\n\n    // kosh (request pal for architecture) → pal (respond with architecture decisions)\n    const archReqId = await this.context.createRequest('kosh', 'pal', 'architecture-review', 'Need system architecture for database design');\n    const palArchResponse = await this.context.getAgentOutput('pal');\n    await this.context.respondToRequest(archReqId, 'pal', `Architecture: ${JSON.stringify(palArchResponse)}`);\n\n    // kosh (request bandh for security requirements) → bandh (respond with security specs)\n    const secReqId = await this.context.createRequest('kosh', 'bandh', 'security-requirements', 'Need security specs for database');\n    const bandhSecResponse = await this.context.getAgentOutput('bandh');\n    await this.context.respondToRequest(secReqId, 'bandh', `Security: ${JSON.stringify(bandhSecResponse)}`);\n\n    // kosh (complete database 