ct.entries(patterns)) {\n      if (keywords.some(keyword => text.includes(keyword))) {\n        entities.push({\n          name: this.capitalize(entityName),\n          fields: this.generateEntityFields(entityName),\n          tableName: entityName.toLowerCase()\n        });\n      }\n    }\n    \n    // Always include User entity\n    if (!entities.find(e => e.name === 'User')) {\n      entities.unshift({\n        name: 'User',\n        fields: this.generateEntityFields('user'),\n        tableName: 'user'\n      });\n    }\n    \n    return entities;\n  }\n\n  generateEntityFields(entityType) {\n    const commonFields = [\n      { name: 'id', type: 'String', attributes: ['@id', '@default(cuid())'] },\n      { name: 'createdAt', type: 'DateTime', attributes: ['@default(now())'] },\n      { name: 'updatedAt', type: 'DateTime', attributes: ['@updatedAt'] }\n    ];\n    \n    const specificFields = {\n      user: [\n        { name: 'name', type: 'String' },\n        { name: 'email', type: 'String', attributes: ['@unique'] },\n        { name: 'image', type: 'String?', attributes: [] },\n        { name: 'role', type: 'UserRole', attributes: ['@default(USER)'] }\n      ],\n      post: [\n        { name: 'title', type: 'String' },\n        { name: 'content', type: 'String' },\n        { name: 'published', type: 'Boolean', attributes: ['@default(false)'] },\n        { name: 'authorId', type: 'String' }\n      ],\n      comment: [\n        { name: 'content', type: 'String' },\n        { name: 'authorId', type: 'String' },\n        { name: 'postId', type: 'String' }\n      ],\n      task: [\n        { name: 'title', type: 'String' },\n        { name: 'description', type: 'String?' },\n        { name: 'status', type: 'TaskStatus', attributes: ['@default(TODO)'] },\n        { name: 'priority', type: 'Priority', attributes: ['@default(MEDIUM)'] },\n        { name: 'dueDate', type: 'DateTime?' },\n        { name: 'userId', type: 'String' },\n        { name: 'assigneeId', type: 'String?' }\n      ],\n      project: [\n        { name: 'name', type: 'String' },\n        { name: 'description', type: 'String?' },\n        { name: 'userId', type: 'String' }\n      ]\n    };\n    \n    return [...commonFields, ...(specificFields[entityType] || [])];\n  }\n\n  inferRelationships(entities) {\n    const relationships = [];\n    \n    // Common relationship patterns\n    const patterns = [\n      // User relationships\n      { from: 'User', to: 'Post', type: 'oneToMany', field: 'posts' },\n      { from: 'User', to: 'Comment', type: 'oneToMany', field: 'comments' },\n      { from: 'User', to: 'Task', type: 'oneToMany', field: 'tasks' },\n      { from: 'User', to: 'Project', type: 'oneToMany', field: 'projects' },\n      \n      // Content relationships\n      { from: 'Post', to: 'Comment', type: 'oneToMany', field: 'comments' },\n      { from: 'Project', to: 'Task', type: 'oneToMany', field: 'tasks' },\n      \n      // Assignment relationships\n      { from: 'Task', to: 'User', type: 'manyToOne', field: 'assignee', foreignKey: 'assigneeId' }\n    ];\n    \n    const entityNames = entities.map(e => e.name);\n    \n    for (const pattern of patterns) {\n      if (entityNames.includes(pattern.from) && entityNames.includes(pattern.to)) {\n        relationships.push(pattern);\n      }\n    }\n    \n    return relationships;\n  }\n\n  generatePrismaSchema(entities, relationships) {\n    let schema = `// Database Schema - Generated by KOSH\ngenerator client {\n  provider = \"prisma-client-js\"\n}\n\ndatasource db {\n  provider = \"postgresql\"\n  url      = env(\"DATABASE_URL\")\n}\n\n`;\n\n    // Generate enums\n    const enums = this.generateEnums();\n    schema += enums + '\\n';\n    \n    // Generate models\n    for (const entity of entities) {\n      schema += this.generatePrismaModel(entity, relationships);\n    }\n    \n    return schema;\n  }\n\n  generateEnums() {\n    return `enum UserRole {\n  USER\n  ADMIN\n  SUPER_ADMIN\n}\n\nenum TaskStatus {\n  TODO\n  IN_PROGRESS\n  IN_REVIEW\n  DONE\n  CANCELLED\n}\n\nenum Priority {\n  LOW\n  MEDIUM\n  HIGH\n  URGENT\n}\n\n`;\n  }\n\n  generatePrismaModel(entity, relationships) {\n    let model = `model ${entity.name} {\n`;\n    \n    // Add fields\n    for (const field of entity.fields) {\n      const attributes = field.attributes.length > 0 ? ` ${field.attributes.join(' ')}` : '';\n      model += `  ${field.name} ${field.type}${attributes}\\n`;\n    }\n    \n    // Add relationships\n    const entityRelationships = relationships.filter(r => r.from === entity.name || r.to === entity.name);\n    for (const rel of entityRelationships) {\n      if (rel.from === entity.name) {\n        if (rel.type === 'oneToMany') {\n          model += `  ${rel.field} ${rel.to}[]\\n`;\n        } else if (rel.type === 'manyToOne') {\n          model += `  ${rel.field} ${rel.to} @relation(fields: [${rel.foreignKey}], references: [id])\\n`;\n        }\n      } else if (rel.to === entity.name && rel.type === 'oneToMany') {\n        model += `  author User @relation(fields: [${entity.tableName === 'user' ? 'userId' : 'authorId'}], references: [id])\\n`;\n      }\n    }\n    \n    model += `}\\n\\n`;\n    return model;\n  }\n\n  capitalize(str) {\n    return str.charAt(0).toUpperCase() + str.slice(1);\n  }\n}",
