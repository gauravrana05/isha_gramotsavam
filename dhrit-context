re\",\n        \"src/server/middleware/rateLimit.ts\": \"Rate limiting middleware\",\n        \"src/lib/\": \"Shared utilities and database connection\",\n        \"src/lib/db.ts\": \"Prisma database client\",\n        \"src/lib/auth.ts\": \"Authentication utilities\",\n        \"src/lib/validation.ts\": \"Shared validation schemas\",\n        \"src/types/\": \"TypeScript type definitions\",\n        \"src/types/api.ts\": \"API request/response types\",\n        \"src/types/auth.ts\": \"Authentication types\"\n      },\n      features: [\n        {\n          name: \"authentication\",\n          priority: 1,\n          description: \"User registration, login, JWT tokens, password reset\",\n          dependencies: [],\n          apis: [\n            \"POST /auth/register - Register new user\",\n            \"POST /auth/login - User login\", \n            \"POST /auth/refresh - Refresh JWT token\",\n            \"POST /auth/logout - User logout\",\n            \"POST /auth/forgot-password - Password reset request\",\n            \"POST /auth/reset-password - Reset password with token\"\n          ],\n          middleware: [\"validation\", \"rateLimiting\"],\n          database: [\"users table\"]\n        },\n        {\n          name: \"users\", \n          priority: 2,\n          description: \"User profile management, avatar upload\",\n          dependencies: [\"authentication\"],\n          apis: [\n            \"GET /users/profile - Get user profile\",\n            \"PUT /users/profile - Update user profile\",\n            \"POST /users/avatar - Upload user avatar\",\n            \"GET /users/search - Search users\"\n          ],\n          middleware: [\"auth\", \"validation\"],\n          database: [\"users table\"]\n        },\n        {\n          name: \"teams\",\n          priority: 3, \n          description: \"Team creation, member management, invitations\",\n          dependencies: [\"authentication\", \"users\"],\n          apis: [\n            \"POST /t