                "new_str": "// Coordination State Manager - Track feature completion and dependencies\nimport { RedisManager } from './redis-manager.js';\nimport { DatabaseManager } from './database-manager.js';\n\nexport class CoordinationStateManager {\n  constructor() {\n    this.redis = new RedisManager();\n    this.db = new DatabaseManager();\n  }\n\n  async initializeProject(projectId) {\n    const projectState = {\n      projectId,\n      status: 'initialized',\n      currentPhase: 'architecture',\n      features: {},\n      agents: {\n        pal: { status: 'pending', completedTasks: [] },\n        kalp: { status: 'pending', completedTasks: [] },\n        bandh: { status: 'pending', completedTasks: [] },\n        kosh: { status: 'pending', completedTasks: [] },\n        mool: { status: 'pending', completedTasks: [] },\n        roop: { status: 'pending', completedTasks: [] },\n        gati: { status: 'pending', completedTasks: [] },\n        dhar: { status: 'pending', completedTasks: [] }\n      },\n      approvals: {},\n      blockers: [],\n      createdAt: new Date().toISOString()\n    };\n\n    // Store in Redis for fast access\n    await this.redis.setProjectState(projectId, projectState);\n    \n    // Store in database for persistence\n    await this.db.createProject(projectState);\n    \n    return projectState;\n  }\n\n  async updateFeatureStatus(projectId, featureName, status, agentName) {\n    const projectState = await this.getProjectState(projectId);\n    \n    if (!projectState.features[featureName]) {\n      projectState.features[featureName] = {\n        name: featureName,\n        status: 'pending',\n        backendStatus: 'pending',\n        frontendStatus: 'pending',\n        testStatus: 'pending',\n        deployStatus: 'pending',\n        dependencies: [],\n        blockers: []\n      };\n    }\n    \n    // Update feature status based on agent\n    if (agentName === 'mool') {\n      projectState.features[featureName].backendStatus = status;\n    } else if (agentName === 'roop') {\n      projectState.features[featureName].frontendStatus = status;\n    } else if (agentName === 'dhar') {\n      projectState.features[featureName].testStatus = status;\n    }\n    \n    // Update overall feature status\n    const feature = projectState.features[featureName];\n    if (feature.backendStatus === 'completed' && feature.frontendStatus === 'completed' && feature.testStatus === 'completed') {\n      feature.status = 'completed';\n    } else if (feature.backendStatus === 'implemented' || feature.frontendStatus === 'implemented') {\n      feature.status = 'in-progress';\n    }\n    \n    projectState.updatedAt = new Date().toISOString();\n    \n    // Update both Redis and database\n    await this.redis.setProjectState(projectId, projectState);\n    await this.db.updateProject(projectId, projectState);\n    \n    return projectState;\n  }\n\n  async checkFeatureDependencies(projectId, featureName) {\n    const projectState = await this.getProjectState(projectId);\n    const feature = projectState.features[featureName];\n    \n    if (!feature || !feature.dependencies) {\n      return { canProceed: true, missingDependencies: [] };\n    }\n    \n    const missingDependencies = [];\n    \n    for (const depName of feature.dependencies) {\n      const dependency = projectState.features[depName];\n      if (!dependency || dependency.status !== 'completed') {\n        missingDependencies.push(depName);\n      }\n    }\n    \n    return {\n      canProceed: missingDependencies.length === 0,\n      missingDependencies\n    };\n  }\n\n  async addApprovalRequest(projectId, fromAgent, toAgent, requestType, content) {\n    const requestId = `req_${Date.now()}_${Math.random().toString(36).substr(2, 9)}`;\n    \n    const approvalRequest = {\n      requestId,\n      projectId,\n      fromAgent,\n      toAgent,\n      requestType,\n      content,\n      status: 'pending',\n      createdAt: new Date().toISOString(),\n      respondedAt: null,\n      response: null\n    };\n    \n    // Store in Redis for fast access\n    await this.redis.setApprovalRequest(requestId, approvalRequest);\n    \n    // Store in database for persistence\n    await this.db.createApprovalRequest(approvalRequest);\n    \n    // Update project state\n    const projectState = await this.getProjectState(projectId);\n    if (!projectState.approvals[toAgent]) {\n      projectState.approvals[toAgent] = [];\n    }\n    projectState.approvals[toAgent].push(requestId);\n    \n    await this.redis.setProjectState(projectId, projectState);\n    await this.db.updateProject(projectId, projectState);\n    \n    return approvalRequest;\n  }\n\n  async respondToApproval(requestId, response, status) {\n    const approvalRequest = await this.redis.getApprovalRequest(requestId);\n    if (!approvalRequest) {\n      throw new Error(`Approval request ${requestId} not found`);\n    }\n    \n    approvalRequest.response = response;\n    approvalRequest.status = status;\n    approvalRequest.respondedAt = new Date().toISOString();\n    \n    // Update Redis and database\n    await this.redis.setApprovalRequest(requestId, approvalRequest);\n    await this.db.updateApprovalRequest(requestId, approvalRequest);\n    \n    // If approved, remove blockers\n    if (status === 'approved') {\n      await this.removeBlocker(approvalRequest.projectId, `approval_${requestId}`);\n    }\n    \n    return approvalRequest;\n  }\n\n  async addBlocker(projectId, blockerId, reason, blockedAgent) {\n    const projectState = await this.getProjectState(projectId);\n    \n    const blocker = {\n      blockerId,\n      reason,\n      blockedAgent,\n      createdAt: new Date().toISOString()\n    };\n    \n    projectState.blockers.push(blocker);\n    projectState.updatedAt = new Date().toISOString();\n    \n    await this.redis.setProjectState(projectId, projectState);\n    await this.db.updateProject(projectId, projectState);\n    \n    return blocker;\n  }\n\n  async removeBlocker(projectId, blockerId) {\n    const projectState = await this.getProjectState(projectId);\n    \n    projectState.blockers = projectState.blockers.filter(b => b.blockerId !== blockerId);\n    projectState.updatedAt = new Date().toISOString();\n    \n    await this.redis.setProjectState(projectId, projectState);\n    await this.db.updateProject(projectId, projectState);\n    \n    return projectState;\n  }\n\n  async getProjectState(projectId) {\n    // Try Redis first for speed\n    let projectState = await this.redis.getProjectState(projectId);\n    \n    if (!projectState) {\n      // Fallback to database\n      projectState = await this.db.getProject(projectId);\n      \n      if (projectState) {\n        // Cache in Redis\n        await this.redis.setProjectState(projectId, projectState);\n      }\n    }\n    \n    return projectState;\n  }\n\n  async getNextFeatureToImplement(projectId) {\n    const projectState = await this.getProjectState(projectId);\n    \n    // Define feature order\n    const featureOrder = ['authentication', 'users', 'teams', 'projects', 'tasks', 'comments', 'notifications'];\n    \n    for (const featureName of featureOrder) {\n      const feature = projectState.features[featureName];\n      \n      if (!feature || feature.status === 'pending') {\n        // Check if dependencies are met\n        const depCheck = await this.checkFeatureDependencies(projectId, featureName);\n        \n        if (depCheck.canProceed) {\n          return featureName;\n        }\n      }\n    }\n    \n    return null; // All features complete\n  }\n\n  async getProjectProgress(projectId) {\n    const projectState = await this.getProjectState(projectId);\n    \n    const totalFeatures = Object.keys(projectState.features).length || 7;\n    const completedFeatures = Object.values(projectState.features).filter(f => f.status === 'completed').length;\n    const inProgressFeatures = Object.values(projectState.features).filter(f => f.status === 'in-progress').length;\n    \n    return {\n      projectId,\n      totalFeatures,\n      completedFeatures,\n      inProgressFeatures,\n      pendingFeatures: totalFeatures - completedFeatures - inProgressFeatures,\n      progressPercentage: Math.round((completedFeatures / totalFeatures) * 100),\n      currentPhase: projectState.currentPhase,\n      blockers: projectState.blockers,\n      pendingApprovals: Object.values(projectState.approvals).flat().length\n    };\n  }\n}",
