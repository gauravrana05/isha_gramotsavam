                "old_str": "  async executeBackendAgent(task, requirements, projectId) {\n    const fs = await import('fs');\n    const path = await import('path');\n    \n    const projectPath = path.join(process.cwd(), 'projects', projectId);\n    const backendPath = path.join(projectPath, 'backend');\n    \n    if (!fs.existsSync(backendPath)) {\n      fs.mkdirSync(backendPath, { recursive: true });\n    }\n    \n    const tRPCRouters = {\n      projectId,\n      routers: {\n        auth: {\n          procedures: [\"login\", \"register\", \"refresh\", \"logout\", \"verifyEmail\"],\n          middleware: [\"rateLimiting\", \"validation\"],\n          description: \"Authentication and session management\"\n        },\n        users: {\n          procedures: [\"getProfile\", \"updateProfile\", \"uploadAvatar\", \"getUsers\"],\n          middleware: [\"auth\", \"validation\"],\n          description: \"User profile management\"\n        },\n        teams: {\n          procedures: [\"create\", \"getTeams\", \"invite\", \"updateRole\", \"leave\", \"getMembers\"],\n          middleware: [\"auth\", \"teamAccess\", \"validation\"],\n          description: \"Team management and memberships\"\n        },\n        projects: {\n          procedures: [\"create\", \"getProjects\", \"update\", \"delete\", \"getMembers\", \"updateStatus\"],\n          middleware: [\"auth\", \"projectAccess\", \"validation\"],\n          description: \"Project CRUD operations\"\n        },\n        tasks: {\n          procedures: [\"create\", \"getTasks\", \"update\", \"delete\", \"assign\", \"updateStatus\", \"createSubtask\"],\n          middleware: [\"auth\", \"taskAccess\", \"validation\"],\n          description: \"Task management with assignments\"\n        },\n        comments: {\n          procedures: [\"create\", \"getComments\", \"update\", \"delete\"],\n          middleware: [\"auth\", \"commentAccess\", \"validation\"],\n          description: \"Task comments and discussions\"\n        },\n        notifications: {\n          procedures: [\"getNotifications\", \"markRead\", \"markAllRead\", \"subscribe\"],\n          middleware: [\"auth\", \"validation\"],\n          description: \"Real-time notifications\"\n        }\n      },\n      middleware: {\n        auth: \"JWT token validation and user context\",\n        teamAccess: \"Verify user belongs to team\",\n        projectAccess: \"Verify user has project permissions\",\n        taskAccess: \"Verify user can access task\",\n        commentAccess: \"Verify user can access comment\",\n        rateLimiting: \"Rate limiting per user/IP\",\n        validation: \"Zod schema validation\"\n      },\n      realTimeEvents: {\n        taskUpdated: \"Broadcast to project members\",\n        commentAdded: \"Notify task watchers\",\n        projectUpdated: \"Notify team members\",\n        userOnline: \"Update presence status\"\n      }\n    };\n    \n    fs.writeFileSync(path.join(backendPath, 'trpc-routers.json'), JSON.stringify(tRPCRouters, null, 2));\n    \n    return `✅ BACKEND API COMPLETE - tRPC router specifications:\n\n🔌 **API Routers:**\n- Auth: Login, register, JWT refresh, email verification\n- Users: Profile management, avatar uploads\n- Teams: Team creation, invitations, role management\n- Projects: CRUD operations with team access control\n- Tasks: Task management, assignments, subtasks\n- Comments: Discussion threads on tasks\n- Notifications: Real-time user notifications\n\n🛡️ **Middleware Stack:**\n- Authentication: JWT validation\n- Authorization: Team/project/task access control\n- Rate limiting: Per-user request limits\n- Validation: Zod schema validation\n\n⚡ **Real-time Features:**\n- WebSocket integration for live updates\n- Task change broadcasts\n- Comment notifications\n- User presence tracking\n\n📁 **Files Created:**\n- trpc-routers.json: Complete API specifications\n\n🔄 **Ready for Frontend:**\n- Type-safe tRPC client integration\n- Real-time subscriptions available`;\n  }",
