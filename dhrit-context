                "file_text": "import { writeFileSync, readFileSync, existsSync, mkdirSync } from 'fs';\nimport { join } from 'path';\n\nexport class ProjectStorage {\n  constructor() {\n    this.projectsPath = join(process.cwd(), 'dhrit', 'projects');\n    this.ensureProjectsDirectory();\n  }\n\n  ensureProjectsDirectory() {\n    if (!existsSync(this.projectsPath)) {\n      mkdirSync(this.projectsPath, { recursive: true });\n    }\n  }\n\n  // Create project structure\n  initializeProject(projectId) {\n    const projectPath = join(this.projectsPath, projectId);\n    \n    const directories = [\n      'architecture',\n      'design', \n      'security',\n      'database',\n      'backend',\n      'frontend',\n      'performance',\n      'qa',\n      'coordination'\n    ];\n\n    directories.forEach(dir => {\n      const dirPath = join(projectPath, dir);\n      if (!existsSync(dirPath)) {\n        mkdirSync(dirPath, { recursive: true });\n      }\n    });\n\n    // Create project metadata\n    const metadata = {\n      projectId,\n      createdAt: new Date().toISOString(),\n      status: 'initialized',\n      agents: {\n        pal: { status: 'pending', outputs: [] },\n        kalp: { status: 'pending', outputs: [] },\n        bandh: { status: 'pending', outputs: [] },\n        kosh: { status: 'pending', outputs: [] },\n        mool: { status: 'pending', outputs: [] },\n        roop: { status: 'pending', outputs: [] },\n        gati: { status: 'pending', outputs: [] },\n        dhar: { status: 'pending', outputs: [] }\n      }\n    };\n\n    this.saveProjectMetadata(projectId, metadata);\n    return projectPath;\n  }\n\n  // Save agent output to project\n  saveAgentOutput(projectId, agentName, outputType, content, filename = null) {\n    const projectPath = join(this.projectsPath, projectId);\n    const agentPath = join(projectPath, this.getAgentDirectory(agentName));\n    \n    if (!existsSync(agentPath)) {\n      mkdirSync(agentPath, { recursive: true });\n    }\n\n    const fileName = filename || `${outputType}-${Date.now()}.json`;\n    const filePath = join(agentPath, fileName);\n    \n    const output = {\n      agent: agentName,\n      type: outputType,\n      content,\n      timestamp: new Date().toISOString(),\n      projectId\n    };\n\n    writeFileSync(filePath, JSON.stringify(output, null, 2));\n    \n    // Update project metadata\n    this.updateAgentStatus(projectId, agentName, 'completed', fileName);\n    \n    return filePath;\n  }\n\n  // Get agent directory mapping\n  getAgentDirectory(agentName) {\n    const mapping = {\n      'pal': 'architecture',\n      'kalp': 'design',\n      'bandh': 'security', \n      'kosh': 'database',\n      'mool': 'backend',\n      'roop': 'frontend',\n      'gati': 'performance',\n      'dhar': 'qa'\n    };\n    return mapping[agentName] || agentName;\n  }\n\n  // Load agent output from project\n  loadAgentOutput(projectId, agentName, outputType = null) {\n    const projectPath = join(this.projectsPath, projectId);\n    const agentPath = join(projectPath, this.getAgentDirectory(agentName));\n    \n    if (!existsSync(agentPath)) {\n      return null;\n    }\n\n    // If specific output type requested, look for it\n    if (outputType) {\n      const files = require('fs').readdirSync(agentPath);\n      const targetFile = files.find(f => f.includes(outputType));\n      if (targetFile) {\n        const content = readFileSync(join(agentPath, targetFile), 'utf8');\n        return JSON.parse(content);\n      }\n    }\n\n    // Otherwise return all outputs\n    const files = require('fs').readdirSync(agentPath);\n    return files.map(file => {\n      const content = readFileSync(join(agentPath, file), 'utf8');\n      return JSON.parse(content);\n    });\n  }\n\n  // Project metadata management\n  saveProjectMetadata(projectId, metadata) {\n    const metadataPath = join(this.projectsPath, projectId, 'project-metadata.json');\n    writeFileSync(metadataPath, JSON.stringify(metadata, null, 2));\n  }\n\n  loadProjectMetadata(projectId) {\n    const metadataPath = join(this.projectsPath, projectId, 'project-metadata.json');\n    if (existsSync(metadataPath)) {\n      const content = readFileSync(metadataPath, 'utf8');\n      return JSON.parse(content);\n    }\n    return null;\n  }\n\n  updateAgentStatus(projectId, agentName, status, output = null) {\n    const metadata = this.loadProjectMetadata(projectId);\n    if (metadata) {\n      metadata.agents[agentName].status = status;\n      metadata.agents[agentName].lastUpdated = new Date().toISOString();\n      \n      if (output) {\n        metadata.agents[agentName].outputs.push(output);\n      }\n      \n      this.saveProjectMetadata(projectId, metadata);\n    }\n  }\n\n  // Get project status\n  getProjectStatus(projectId) {\n    const metadata = this.loadProjectMetadata(projectId);\n    if (!metadata) return null;\n\n    const agentStatuses = Object.entries(metadata.agents).map(([agent, data]) => ({\n      agent,\n      status: data.status,\n      outputs: data.outputs.length,\n      lastUpdated: data.lastUpdated\n    }));\n\n    return {\n      projectId,\n      overallStatus: metadata.status,\n      createdAt: metadata.createdAt,\n      agents: agentStatuses\n    };\n  }\n\n  // List all projects\n  listProjects() {\n    if (!existsSync(this.projectsPath)) {\n      return [];\n    }\n\n    const projects = require('fs').readdirSync(this.projectsPath);\n    return projects.map(projectId => {\n      const metadata = this.loadProjectMetadata(projectId);\n      return {\n        projectId,\n        status: metadata?.status || 'unknown',\n        createdAt: metadata?.createdAt || 'unknown'\n      };\n    });\n  }\n}",
