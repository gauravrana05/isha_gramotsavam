{
  "projectId": "task-manager-coordinated",
  "designTokens": {
    "colors": {
      "primary": {
        "50": "#f0f9ff",
        "500": "#0ea5e9",
        "600": "#0284c7",
        "900": "#0c4a6e"
      },
      "neutral": {
        "50": "#fafafa",
        "500": "#737373",
        "900": "#171717"
      },
      "success": {
        "500": "#22c55e"
      },
      "warning": {
        "500": "#f59e0b"
      },
      "error": {
        "500": "#ef4444"
      }
    },
    "typography": {
      "fontFamily": {
        "sans": [
          "Inter",
          "system-ui"
        ],
        "mono": [
          "JetBrains Mono"
        ]
      },
      "fontSize": {
        "xs": "0.75rem",
