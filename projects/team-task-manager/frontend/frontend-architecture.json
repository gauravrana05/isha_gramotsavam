    "/profile": "User profile and settings"
  },
  "components": {
    "layout": [
      "Header",
      "Sidebar",
      "Footer",
      "Container"
    ],
    "auth": [
      "LoginForm",
      "RegisterForm",
      "ProtectedRoute"
    ],
    "teams": [
      "TeamCard",
      "TeamInvite",
      "MemberList"
    ],
    "projects": [
      "ProjectCard",
      "ProjectForm",
      "ProjectStats"
    ],
    "tasks": [
      "TaskCard",
      "TaskForm",
      "KanbanBoard",
      "TaskList"
    ],
    "ui": [
      "Button",
      "Input",
      "Modal",
      "Dropdown",
      "Toast"
    ]
  },
  "features": {
    "authentication": "Login/register with JWT tokens",
    "teamManagement": "Create teams, invite members, manage roles",
    "projectDashboard": "Project overview with progress tracking",
