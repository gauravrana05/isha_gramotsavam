{
  "projectId": "team-task-manager",
  "routers": {
    "auth": {
      "procedures": [
        "login",
        "register",
        "refresh",
        "logout",
        "verifyEmail"
      ],
      "middleware": [
        "rateLimiting",
        "validation"
      ],
      "description": "Authentication and session management"
    },
    "users": {
      "procedures": [
        "getProfile",
        "updateProfile",
        "uploadAvatar",
        "getUsers"
      ],
      "middleware": [
        "auth",
        "validation"
      ],
      "description": "User profile management"
    },
    "teams": {
      "procedures": [
        "create",
        "getTeams",
        "invite",
        "updateRole",
        "leave",
        "getMembers"
      ],
      "middleware": [
        "auth",
        "teamAccess",
        "validation"
      ],
      "description": "Team management and memberships"
    },
    "projects": {
      "procedures": [
        "create",
        "getProjects",
        "update",
        "delete",
        "getMembers",
        "updateStatus"
      ],
      "middleware": [
        "auth",
        "projectAccess",
        "validation"
      ],
      "description": "Project CRUD operations"
    },
    "tasks": {
      "procedures": [
        "create",
        "getTasks",
        "update",
        "delete",
        "assign",
        "updateStatus",
        "createSubtask"
      ],
      "middleware": [
        "auth",
        "taskAccess",
        "validation"
      ],
      "description": "Task management with assignments"
    },
    "comments": {
      "procedures": [
        "create",
        "getComments",
        "update",
        "delete"
      ],
      "middleware": [
        "auth",
        "commentAccess",
        "validation"
      ],
      "description": "Task comments and discussions"
    },
    "notifications": {
      "procedures": [
        "getNotifications",
        "markRead",
        "markAllRead",
        "subscribe"
      ],
      "middleware": [
        "auth",
        "validation"
      ],
      "description": "Real-time notifications"
    }
  },
  "middleware": {
    "auth": "JWT token validation and user context",
    "teamAccess": "Verify user belongs to team",
    "projectAccess": "Verify user has project permissions",
    "taskAccess": "Verify user can access task",
    "commentAccess": "Verify user can access comment",
    "rateLimiting": "Rate limiting per user/IP",
    "validation": "Zod schema validation"
  },
  "realTimeEvents": {
    "taskUpdated": "Broadcast to project members",
    "commentAdded": "Notify task watchers",
    "projectUpdated": "Notify team members",
    "userOnline": "Update presence status"
  }
}